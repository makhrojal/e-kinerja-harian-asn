t-weight: 650;\n  line-height: 1.4;\n}\n.report-wfh-action p {\n  margin: 4px 0 0;\n  color: var(--ink-muted);\n  font-size: 12.5px;\n  line-height: 1.5;\n}\n.report-wfh-action button {\n  flex-shrink: 0;\n  min-height: 44px;\n  white-space: nowrap;\n}\n.wfh-workspace{container-type:inline-size;margin-top:24px;border-top:1px solid var(--border-subtle);padding-top:22px}\n.wfh-workspace-heading{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:16px}\n.wfh-workspace-heading h3{font-size:20px;line-height:1.3;letter-spacing:-.02em;color:var(--ink-primary);margin:4px 0}\n.wfh-workspace-heading p{font-size:13px;line-height:1.5;color:var(--ink-muted);margin:0}\n.wfh-profile-details{border:1px solid var(--border-subtle);border-radius:var(--radius-md);background:var(--bg-surface);margin-bottom:18px}\n.wfh-profile-details>summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:62px;padding:12px 16px}\n.wfh-profile-details>summary::-webkit-details-marker{display:none}\n.wfh-profile-details>summary::after{content:'⌄';font-size:20px;color:var(--ink-muted);transition:transform .2s}\n.wfh-profile-details[open]>summary::after{transform:rotate(180deg)}\n.wfh-profile-label{font-size:14px;font-weight:650;color:var(--ink-primary);white-space:nowrap}\n.wfh-profile-label small{display:block;margin-top:3px;font-size:11px;font-weight:400;color:var(--ink-muted)}\n.wfh-profile-summary{display:flex;gap:10px;align-items:center;justify-content:flex-end;min-width:0;color:var(--ink-secondary);font-size:12px}\n.wfh-profile-summary>*{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:170px}\n.wfh-profile-summary>*+*::before{content:'· ';color:var(--ink-muted)}\n.wfh-profile-form{padding:0 16px 18px;border-top:1px solid var(--border-subtle)}\n.wfh-profile-fields{max-width:760px;padding-top:18px}\n.wfh-profile-form h2{font-size:17px;margin:3px 0 8px}\n.wfh-profile-form .formactions{flex-wrap