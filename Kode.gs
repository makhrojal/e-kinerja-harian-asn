lid var(--border-subtle);\n  border-radius: var(--radius-md);\n  padding: 14px 16px;\n  margin-bottom: 20px;\n  box-shadow: var(--shadow-xs);\n  transition: background 0.2s, border-color 0.2s;\n}\n.heatmap-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 12px;\n}\n.heatmap-title-wrap {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.heatmap-title-wrap svg {\n  width: 16px;\n  height: 16px;\n  color: var(--brand);\n  stroke: var(--brand);\n  stroke-width: 2;\n  fill: none;\n}\n.heatmap-title-wrap h3 {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--ink-primary);\n  margin: 0;\n}\n.heatmap-legend {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  color: var(--ink-muted);\n}\n.heatmap-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(36px, 1fr));\n  gap: 6px;\n  padding: 4px 0;\n}\n.heatmap-tile {\n  aspect-ratio: 1 / 1;\n  border-radius: var(--radius-sm);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 11.5px;\n  font-weight: 600;\n  cursor: pointer;\n  border: 1px solid var(--border-subtle);\n  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;\n  position: relative;\n  user-select: none;\n}\n.heatmap-tile:hover {\n  transform: translateY(-2px) scale(1.04);\n  box-shadow: var(--shadow-sm);\n  z-index: 2;\n}\n.heatmap-tile.level-0 {\n  background: var(--bg-app);\n  color: var(--ink-tertiary);\n}\n.heatmap-tile.level-1 {\n  background: #dcfce7;\n  color: #15803d;\n  border-color: #bbf7d0;\n}\n.heatmap-tile.level-2 {\n  background: #86efac;\n  color: #14532d;\n  border-color: #4ade80;\n}\n.heatmap-tile.level-3 {\n  background: #22c55e;\n  color: #ffffff;\n  border-color: #16a34a;\n}\n:root[data-theme=\"dark\"] .heatmap-tile.level-0 {\n  background: rgba(255, 255, 255, 0.04);\n  color: #64748b;\n  border-color: #334155;\n}\n:root[data-theme=\"dark\"] .heatmap-tile.level-1 {\n  background: rgba(34, 197, 94, 0.2);\n  color: #86efac;\n  border-color: rgba(34, 197, 94, 0.35);\n}\n:root[data-theme=\"dark\"] .heatmap-tile.level-2 {\n  background: rgba(34, 197, 94, 0.45);\n  color: #dcfce7;\n  border-color: rgba(34, 197, 94, 0.6);\n}\n:root[data-theme=\"dark\"] .heatmap-tile.level-3 {\n  background: #16a34a;\n  color: #ffffff;\n  border-color: #22c55e;\n  box-shadow: 0 0 8px rgba(34, 197, 94, 0.3);\n}\n.heatmap-tile.is-today {\n  outline: 2px solid var(--brand);\n  outline-offset: 1px;\n}\n.heatmap-tile.is-active-filter {\n  box-shadow: 0 0 0 2px var(--brand);\n  border-color: var(--brand);\n}\n.heatmap-tile .tile-count {\n  font-size: 8.5px;\n  opacity: 0.85;\n  line-height: 1;\n  margin-top: 1px;\n}\n.heatmap-cell {\n  width: 12px;\n  height: 12px;\n  border-radius: 2px;\n  display: inline-block;\n}\n.heatmap-cell.level-0 { background: var(--bg-app); border: 1px solid var(--border-subtle); }\n.heatmap-cell.level-1 { background: #dcfce7; border: 1px solid #bbf7d0; }\n.heatmap-cell.level-2 { background: #86efac; border: 1px solid #4ade80; }\n.heatmap-cell.level-3 { background: #22c55e; border: 1px solid #16a34a; }\n:root[data-theme=\"dark\"] .heatmap-cell.level-0 { background: rgba(255, 255, 255, 0.04); border-color: #334155; }\n:root[data-theme=\"dark\"] .heatmap-cell.level-1 { background: rgba(34, 197, 94, 0.25); border-color: rgba(34, 197, 94, 0.4); }\n:root[data-theme=\"dark\"] .heatmap-cell.level-2 { background: rgba(34, 197, 94, 0.5); border-color: rgba(34, 197, 94, 0.7); }\n:root[data-theme=\"dark\"] .heatmap-cell.level-3 { background: #16a34a; border-color: #22c55e; }\n.heatmap-day-meta {\n  margin-top: 10px;\n  padding: 8px 12px;\n  background: var(--brand-tint);\n  border: 1px solid rgba(37, 99, 235, 0.2);\n  border-radius: var(--radius-sm);\n  font-size: 12px;\n  color: var(--brand);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.heatmap-day-meta button {\n  background: none;\n  border: none;\n  color: var(--brand);\n  font-size: 11.5px;\n  font-weight: 600;\n  text-decoration: underline;\n  cursor: pointer;\n  padding: 0;\n}\n\n/* Smart Natural Language Date & Priority Chips (ST1-01) */\n.quick-suggestion-bar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 6px;\n  margin-bottom: 8px;\n  flex-wrap: wrap;\n}\n.date-chip-btn, .prio-chip-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  background: var(--brand-tint);\n  border: 1px solid rgba(37, 99, 235, 0.25);\n  border-radius: var(--radius-sm);\n  padding: 4px 8px;\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--brand);\n  cursor: pointer;\n  transition: background 0.15s, border-color 0.15s, transform 0.1s;\n  user-select: none;\n}\n.date-chip-btn:hover, .prio-chip-btn:hover {\n  background: rgba(37, 99, 235, 0.15);\n  border-color: var(--brand);\n  transform: translateY(-1px);\n}\n.date-chip-btn svg {\n  width: 13px;\n  height: 13px;\n  stroke: var(--brand);\n  stroke-width: 2;\n  fill: none;\n}\n.date-chip-btn .chip-action, .prio-chip-btn .chip-action {\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  background: var(--brand);\n  color: #fff;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n:root[data-theme=\"dark\"] .date-chip-btn, :root[data-theme=\"dark\"] .prio-chip-btn {\n  background: rgba(37, 99, 235, 0.15);\n  border-color: rgba(37, 99, 235, 0.4);\n  color: #93c5fd;\n}\n:root[data-theme=\"dark\"] .date-chip-btn svg {\n  stroke: #93c5fd;\n}\n\n.kanban-chips {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.chip-btn {\n  font-size: 12px;\n  font-weight: 500;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-surface);\n  color: var(--ink-secondary);\n  cursor: pointer;\n  transition: all 0.15s ease;\n  line-height: 1.4;\n  white-space: nowrap;\n}\n\n