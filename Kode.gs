n  height: 17px;\n  flex-shrink: 0;\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* App Frame & Sidebar */\n.appframe {\n  display: flex;\n  min-height: 100vh;\n}\n\n.sidebar {\n  width: 236px;\n  position: fixed;\n  inset: 0 auto 0 0;\n  background: var(--bg-sidebar);\n  border-right: 1px solid var(--border-subtle);\n  padding: 24px 14px 20px;\n  display: flex;\n  flex-direction: column;\n  z-index: 10;\n}\n\n.brand {\n  display: flex;\n  gap: 11px;\n  align-items: center;\n  padding: 0 8px 24px;\n}\n\n.brand-info {\n  display: flex;\n  flex-direction: column;\n  line-height: 1.15;\n}\n\n.brand-title {\n  font-size: 14.5px;\n  font-weight: 700;\n  color: var(--ink-primary);\n  letter-spacing: -0.02em;\n}\n\n.brand-sub {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--brand);\n  text-transform: uppercase;\n  letter-spacing: 0.07em;\n}\n\n.brandmark {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  display: grid;\n  place-items: center;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);\n  padding: 3px;\n  flex-shrink: 0;\n  transition: transform 0.15s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.15s ease;\n}\n\n.brandmark:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.12);\n}\n\n.brandmark svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.navhint {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--ink-tertiary);\n  margin: 0 10px 8px;\n}\n\n.sidebar nav {\n  display: grid;\n  gap: 4px;\n}\n\n.sidebar nav button {\n  justify-content: flex-start;\n  background: transparent;\n  border: 1px solid transparent;\n  color: var(--ink-secondary);\n  padding: 9px 12px;\n  min-height: 38px;\n  font-weight: 500;\n  font-size: 13px;\n  border-radius: var(--radius-md);\n  box-shadow: none;\n}\n\n.sidebar nav button:hover {\n  background: rgba(241, 245, 249, 0.8);\n  color: var(--ink-primary);\n  border-color: transparent;\n}\n\n.sidebar nav button.active {\n  background: var(--bg-surface);\n  color: var(--brand);\n  font-weight: 600;\n  border-color: var(--border-subtle);\n  box-shadow: var(--shadow-xs);\n}\n\n.sidefoot {\n  margin-top: auto;\n  padding: 16px 12px 0;\n  font-size: 11.5px;\n  color: var(--ink-muted);\n  border-top: 1px solid var(--border-subtle);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.sidefoot a {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--ink-secondary);\n  text-decoration: none;\n  font-weight: 500;\n  transition: color 0.15s ease;\n}\n\n.sidefoot a:hover {\n  color: var(--brand);\n}\n\n.hotkey-hint {\n  font-size: 10.5px;\n  color: var(--ink-tertiary);\n  margin-top: 4px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.hotkey-hint kbd {\n  background: #f1f5f9;\n  border: 1px solid var(--border-subtle);\n  border-radius: 4px;\n  padding: 1px 4px;\n  font-size: 10px;\n  font-family: inherit;\n  color: var(--ink-secondary);\n}\n\n.semver-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.semver-tag {\n  display: inline-block;\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  font-size: 10px;\n  font-weight: 700;\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: var(--brand-tint);\n  color: var(--brand);\n  border: 1px solid rgba(37, 99, 235, 0.18);\n  letter-spacing: 0.02em;\n}\n\n/* Shell & Header */\n.shell {\n  margin-left: 236px;\n  padding: 24px 44px 40px;\n  width: calc(100% - 236px);\n  min-width: 0;\n  max-width: 1440px;\n}\n\nheader {\n  min-height: 68px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  border-bottom: 1px solid var(--border-subtle);\n  margin-bottom: 24px;\n  padding-bottom: 16px;\n}\n\nh1 {\n  font-size: 22px;\n  letter-spacing: -0.025em;\n  line-height: 1.25;\n  margin: 0 0 3px;\n  font-weight: 700;\n  color: var(--ink-primary);\n}\n\nh2 {\n  font-size: 16px;\n  font-weight: 650;\n  letter-spacing: -0.015em;\n  margin: 0;\n  color: var(--ink-primary);\n}\n\np {\n  margin: 3px 0;\n  color: var(--ink-muted);\n}\n\nheader p {\n  font-size: 12.5px;\n  margin: 0;\n}\n\n.eyebrow {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--ink-muted);\n}\n\n.actions, .row {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n/* Notices & Banners */\n.notice {\n  font-size: 12.5px;\n  font-weight: 500;\n  min-height: 20px;\n  margin: 0 0 20px;\n  padding: 10px 14px;\n  border-radius: var(--radius-md);\n  background: var(--brand-tint);\n  color: #1e40af;\n  border: 1px solid rgba(37, 99, 235, 0.16);\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  box-shadow: var(--shadow-xs);\n}\n\n.notice:empty {\n  display: none;\n}\n\n.notice:not(:empty)::before {\n  content: '';\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--brand);\n  flex-shrink: 0;\n}\n\n.notice.error {\n  color: #991b1b;\n  background: var(--danger-bg);\n  border-color: rgba(220, 38, 38, 0.2);\n}\n\n.notice.error::before {\n  background: var(--danger);\n}\n\n#demoBanner, #offlineBanner {\n  background: var(--warning-bg);\n  color: #92400e;\n  border-color: rgba(217, 119, 6, 0.2);\n}\n\n#demoBanner::before, #offlineBanner::before {\n  background: var(--warning);\n}\n\n/* Hero Section */\n.hero {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 20px;\n  padding: 24px 28px;\n  margin: 0 0 24px;\n  background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-app) 100%);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-xs);\n}\n\n.hero h2 {\n  font-size: 20px;\n  letter-spacing: -0.02em;\n  font-weight: 700;\n  margin: 4px 0;\n  color: var(--ink-primary);\n}\n\n.hero p {\n  font-size: 13px;\n  color: var(--ink-secondary);\n}\n\n.hero .eyebrow {\n  color: var(--brand);\n}\n\n.heroart {\n  display: none;\n}\n\n/* Section Titles & Filters */\n.sectiontitle {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin: 24px 0 14px;\n}\n\n.period {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--ink-secondary);\n}\n\n.period input, .month {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  padding: 5px 8px;\n  color: var(--ink-primary);\n  font-size: 12.5px;\n  box-shadow: var(--shadow-xs);\n}\n\n/* Stats Cards */\n.stats {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-xs);\n  padding: 18px 0;\n  margin-bottom: 28px;\n}\n\n.stat {\n  padding: 0 24px;\n  border-right: 1px solid var(--border-light);\n}\n\n.stat:last-child {\n  border-right: 0;\n}\n\n.stat span {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--ink-muted);\n  display: block;\n}\n\n.stat strong {\n  display: block;\n  font-size: 26px;\n  line-height: 1.25;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n  margin-top: 6px;\n  letter-spacing: -0.025em;\n  color: var(--ink-primary);\n}\n\n/* Home Grid & Panels */\n.homegrid {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 280px;\n  gap: 24px;\n}\n\n.panel {\n  min-width: 0;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-xs);\n  padding: 20px 22px;\n}\n\n.panelhead {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n.quickactions {\n  display: grid;\n  gap: 4px;\n  margin: 14px 0 0;\n}\n\n.quickactions button {\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  padding: 10px 12px;\n  justify-content: flex-start;\n  text-align: left;\n  font-size: 13px;\n  background: transparent;\n  color: var(--ink-secondary);\n  box-shadow: none;\n}\n\n.quickactions button:hover {\n  background: #f8fafc;\n  color: var(--brand);\n}\n\n.quickactions button .icon {\n  color: var(--ink-tertiary);\n  transition: color 0.15s ease;\n}\n\n.quickactions button:hover .icon {\n  color: var(--brand);\n}\n\n/* Empty States */\n.empty {\n  padding: 32px 18px;\n  border: 1px dashed #cbd5e1;\n  border-radius: var(--radius-md);\n  text-align: center;\n  font-size: 13px;\n  color: var(--ink-muted);\n  background: #f8fafc;\n  line-height: 1.6;\n}\n\n/* Recent Notes & Entries */\n.recent {\n  border-bottom: 1px solid var(--border-light);\n  padding: 14px 0;\n  transition: background 0.15s ease;\n}\n\n.recent:first-child {\n  padding-top: 2px;\n}\n\n.recent:last-child {\n  border-bottom: 0;\n}\n\n.recent h3 {\n  font-size: 13.5px;\n  margin: 6px 0 3px;\n  font-weight: 600;\n  color: var(--ink-primary);\n  overflow-wrap: anywhere;\n}\n\n.recent p {\n  font-size: 12.5px;\n  color: var(--ink-secondary);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  margin: 3px 0;\n}\n\n.recent .row {\n  justify-content: space-between;\n}\n\n.recent .eyebrow {\n  font-size: 11px;\n}\n\n.recent button, .mini {\n  font-size: 12px;\n  padding: 4px 10px;\n  min-height: 28px;\n  border-radius: var(--radius-sm);\n}\n\n.recent .badge {\n  margin-top: 7px;\n}\n\n/* Status Badges */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 2.5px 8px;\n  background: var(--success-bg);\n  color: var(--success);\n  border: 1px solid rgba(5, 150, 105, 0.2);\n  border-radius: var(--radius-sm);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.01em;\n}\n\n.badge::before {\n  content: '';\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.badge.wait {\n  background: var(--brand-tint);\n  color: var(--brand);\n  border-color: rgba(37, 99, 235, 0.2);\n}\n\n/* Priority Badges */\n.priority-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  padding: 1px 6px;\n  font-size: 10.5px;\n  font-weight: 700;\n  border-radius: 4px;\n  letter-spacing: 0.02em;\n}\n.priority-pill.p1 { background: var(--p1-bg); color: var(--p1-color); border: 1px solid rgba(220, 38, 38, 0.25); }\n.priority-pill.p2 { background: var(--p2-bg); color: var(--p2-color); border: 1px solid rgba(217, 119, 6, 0.25); }\n.priority-pill.p3 { background: var(--p3-bg); color: var(--p3-color); border: 1px solid rgba(37, 99, 235, 0.25); }\n.priority-pill.p4 { background: var(--p4-bg); color: var(--p4-color); border: 1px solid rgba(100, 116, 139, 0.2); }\n\n/* Todoist-style Interactive Cards */\n.todo-card {\n  display: flex;\n  gap: 12px;\n  align-items: flex-start;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--border-light);\n  transition: background 0.15s ease;\n}\n.todo-card:first-child { padding-top: 2px; }\n.todo-card:last-child { border-bottom: 0; }\n.todo-check-btn {\n  position: relative;\n  flex: 0 0 22px !important;\n  width: 22px !important;\n  height: 22px !important;\n  min-width: 22px !important;\n  min-height: 22px !important;\n  max-width: 22px !important;\n  max-height: 22px !important;\n  aspect-ratio: 1 / 1 !important;\n  border-radius: 50% !important;\n  box-sizing: border-box !important;\n  border: 2px solid #94a3b8;\n  background: transparent;\n  padding: 0 !important;\n  cursor: pointer;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  margin-top: 2px;\n  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);\n  box-shadow: none;\n  touch-action: manipulation;\n  -webkit-tap-highlight-color: transparent;\n  transform-origin: center center;\n}\n.todo-check-btn::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 44px;\n  height: 44px;\n  min-width: 44px;\n  min-height: 44px;\n  aspect-ratio: 1 / 1;\n  pointer-events: auto;\n}\n.todo-check-btn.p1 { border-color: var(--p1-color); }\n.todo-check-btn.p2 { border-color: var(--p2-color); }\n.todo-check-btn.p3 { border-color: var(--p3-color); }\n.todo-check-btn.p4 { border-color: var(--p4-color); }\n.todo-check-btn:hover {\n  transform: scale(1.12);\n  background: rgba(37, 99, 235, 0.08);\n}\n.todo-check-btn.p1:hover { background: rgba(220, 38, 38, 0.12); }\n.todo-check-btn.p2:hover { background: rgba(217, 119, 6, 0.12); }\n.todo-check-btn.p3:hover { background: rgba(37, 99, 235, 0.12); }\n.todo-check-btn.done {\n  background: var(--success);\n  border-color: var(--success);\n}\n.todo-check-btn svg {\n  width: 12px;\n  height: 12px;\n  stroke: #ffffff;\n  stroke-width: 3;\n  fill: none;\n  opacity: 0;\n  transform: scale(0.5);\n  transition: all 0.15s ease;\n}\n.todo-check-btn.done svg {\n  opacity: 1;\n  transform: scale(1);\n}\n.todo-main {\n  flex-grow: 1;\n  min-width: 0;\n}\n.todo-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n}\n.todo-meta {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.todo-title {\n  font-size: 13.5px;\n  margin: 5px 0 3px;\n  font-weight: 600;\n  color: var(--ink-primary);\n  overflow-wrap: anywhere;\n  transition: color 0.15s ease;\n}\n.todo-title.done {\n  color: var(--ink-muted);\n  text-decoration: line-through;\n  text-decoration-color: rgba(100, 116, 139, 0.45);\n}\n.todo-desc {\n  font-size: 12px;\n  color: var(--ink-secondary);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  margin: 2px 0;\n}\n\n/* Undo Toast Snackbar */\n.undo-toast {\n  position: fixed;\n  bottom: 28px;\n  left: 50%;\n  transform: translateX(-50%) translateY(80px);\n  background: #0f172a;\n  color: #f8fafc;\n  padding: 0;\n  border-radius: 9999px;\n  overflow: hidden;\n  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.24);\n  font-size: 12.5px;\n  font-weight: 500;\n  z-index: 9999;\n  opacity: 0;\n  pointer-events: none;\n  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;\n}\n.undo-toast.visible {\n  transform: translateX(-50%) translateY(0);\n  opacity: 1;\n  pointer-events: auto;\n}\n.undo-toast-content {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 18px 12px 18px;\n}\n.undo-toast button {\n  background: transparent;\n  border: none;\n  color: #60a5fa;\n  font-weight: 700;\n  font-size: 12.5px;\n  cursor: pointer;\n  padding: 2px 6px;\n  border-radius: 4px;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n.undo-toast button:hover {\n  text-decoration: underline;\n  color: #93c5fd;\n}\n.undo-countdown {\n  font-size: 11px;\n  font-weight: 500;\n  color: #94a3b8;\n}\n.undo-progress-bar {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  height: 3px;\n  width: 100%;\n  background: #3b82f6;\n  transform-origin: left;\n  transform: scaleX(1);\n}\n.undo-progress-bar.running {\n  animation: undoBarAnim 5s linear forwards;\n}\n@keyframes undoBarAnim {\n  from { transform: scaleX(1); }\n  to { transform: scaleX(0); }\n}\n\n/* Quick Add Modal Dialog */\n.quick-add-dialog {\n  width: min(520px, 94vw);\n  border-radius: var(--radius-lg);\n  padding: 18px 20px;\n  border: 1px solid var(--border-subtle);\n  box-shadow: var(--shadow-float);\n}\n.quick-add-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n.quick-add-title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-weight: 700;\n  font-size: 14px;\n  color: var(--ink-primary);\n}\n.quick-add-input {\n  width: 100%;\n  font-size: 14px;\n  padding: 10px 12px;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  outline: none;\n}\n.quick-add-input:focus {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);\n}\n.quick-add-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 12px;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.quick-add-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.mini-select, .mini-date {\n  font-size: 11.5px;\n  padding: 3px 6px;\n  border-radius: var(--radius-xs);\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-surface);\n  color: var(--ink-primary);\n}\n.quick-add-btns {\n  display: flex;\n  gap: 6px;\n}\n.formrow-3 {\n  grid-template-columns: 1.2fr 1fr 1fr;\n}\n@media (max-width: 768px) {\n  .formrow-3 {\n    grid-template-columns: 1fr;\n  }\n}\n\n.pageintro {\n  display: none;\n}\n\n/* Paket 3: Focus & Habit Tracking */\n.focus-panel {\n  margin-bottom: 24px;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  padding: 20px 22px;\n  box-shadow: var(--shadow-sm);\n  position: relative;\n  overflow: hidden;\n}\n\n.focus-panel::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3.5px;\n  background: linear-gradient(90deg, #4285f4 0%, #34a853 45%, #fbbc05 80%, #ea4335 100%);\n}\n\n.focus-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 16px;\n  margin-bottom: 12px;\n}\n\n.focus-eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 11.5px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--ink-tertiary);\n  margin-bottom: 4px;\n  flex-wrap: wrap;\n}\n\n.focus-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--ink-primary);\n  margin: 0;\n  letter-spacing: -0.02em;\n}\n\n.streak-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 2.5px 9px;\n  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);\n  