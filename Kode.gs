n  .sidebar nav button:active {\n    transform: scale(0.94);\n  }\n  .sidebar nav button .icon {\n    width: 20px;\n    height: 20px;\n    stroke-width: 2px;\n  }\n  .sidebar nav button.active {\n    color: var(--brand);\n    font-weight: 600;\n    background: var(--brand-tint);\n  }\n  .sidebar nav button.active .icon {\n    color: var(--brand);\n  }\n\n  /* Main Viewport Shell padding */\n  .shell {\n    margin-left: 0 !important;\n    width: 100% !important;\n    padding: 16px 14px calc(80px + env(safe-area-inset-bottom, 0px)) !important;\n  }\n\n  /* Floating Undo Toast elevated above Bottom Tab Bar */\n  .undo-toast {\n    bottom: calc(72px + env(safe-area-inset-bottom, 0px));\n    width: calc(100% - 24px);\n    max-width: 420px;\n    padding: 0;\n    font-size: 12px;\n    border-radius: 12px;\n    z-index: 1001;\n  }\n  .undo-toast-content {\n    padding: 8px 14px 10px 14px;\n    justify-content: space-between;\n    width: 100%;\n  }\n  .undo-toast button {\n    min-height: 44px;\n    display: inline-flex;\n    align-items: center;\n    padding: 4px 10px;\n    touch-action: manipulation;\n  }\n\n  /* Anti Auto-Zoom (Safari iOS requires font-size >= 16px) */\n  label input,\n  label select,\n  label textarea,\n  .quick-add-input,\n  .quick-add-select,\n  #search,\n  #from,\n  #to,\n  #statusFilter {\n    font-size: 16px !important;\n  }\n  label input,\n  label select,\n  .mini-select,\n  .mini-date {\n    min-height: 44px;\n  }\n\n  /* Touch Target Ergonomics (>= 44x44 pt) */\n  button,\n  .preset-btn,\n  .quick-add-btn,\n  header .actions button,\n  .formactions button {\n    min-height: 44px;\n    touch-action: manipulation;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .todo-card button.mini {\n    min-height: 38px;\n    padding: 6px 12px;\n    touch-action: manipulation;\n  }\n\n  header {\n    min-height: 52px;\n    gap: 8px;\n  }\n  h1 {\n    font-size: 20px;\n  }\n  header p {\n    max-width: 220px;\n    font-size: 12px;\n  }\n  header .actions {\n    gap: 6px;\n  }\n  header .actions button {\n    font-size: 12px;\n    padding: 6px 10px;\n  }\n  #refresh {\n    font-size: 0;\n    gap: 0;\n    padding: 6px 8px;\n  }\n  #refresh .icon {\n    width: 17px;\n  }\n  .sectiontitle {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .stats {\n    grid-template-columns: repeat(2, 1fr);\n    row-gap: 16px;\n    padding: 14px 0;\n  }\n  .stat:nth-child(3) {\n    padding-left: 16px;\n  }\n  .stat:nth-child(2) {\n    border-right: 0;\n  }\n  .stat strong {\n    font-size: 22px;\n  }\n  .quickactions {\n    grid-template-columns: 1fr;\n  }\n  .hero h2 {\n    font-size: 19px;\n  }\n  .day {\n    min-height: 68px;\n  }\n  .day small {\n    font-size: 9px;\n    padding: 2px 4px;\n  }\n  .layout > .panel:first-child .panelhead {\n    padding: 12px 14px;\n  }\n  .month {\n    max-width: 140px;\n  }\n  .formrow {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n  .inputpage .panel {\n    padding: 20px 16px;\n  }\n  .report .actions {\n    padding: 12px;\n  }\n  .report .actions label {\n    width: calc(50% - 4px);\n  }\n  .report .actions button {\n    flex-grow: 1;\n  }\n  .formactions {\n    flex-wrap: wrap;\n  }\n  .formstate {\n    width: 100%;\n    margin-bottom: 8px;\n  }\n  .quick-add-dialog {\n    width: min(100vw - 24px, 480px);\n    padding: 16px 14px;\n    margin: auto 12px;\n  }\n  .quick-add-actions {\n    flex-wrap: wrap;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * {\n    scroll-behavior: auto !important;\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n@media print {\n  :root, :root[data-theme=\"dark\"], body {\n    background: #ffffff !important;\n    color: #000000 !important;\n    font-size: 11pt;\n  }\n  .sidebar, header, .notice, footer, .report .actions, .hint, .actions, .preset-bar {\n    display: none !important;\n  }\n  .shell {\n    margin: 0 !important;\n    width: 100% !important;\n    padding: 0 !important;\n  }\n  #printHeader {\n    display: block !important;\n    border-bottom: 2px solid #000;\n    padding-bottom: 12px;\n    margin-bottom: 20px;\n    text-align: center;\n  }\n  #printHeader h2 {\n    font-size: 16pt;\n    margin: 0;\n  }\n  #printHeader p {\n    font-size: 10pt;\n    margin: 4px 0 0;\n    color: #333;\n  }\n  #printFooter {\n    display: flex !important;\n    justify-content: space-between;\n    margin-top: 50px;\n    page-break-inside: avoid;\n    font-size: 10.5pt;\n  }\n  .print-sig {\n    text-align: center;\n    width: 220px;\n  }\n  .print-sig-space {\n    height: 60px;\n  }\n  table {\n    font-size: 9.5pt;\n  }\n  thead {\n    display: table-header-group;\n  }\n  tr {\n    page-break-inside: avoid;\n  }\n  th, td {\n    border: 1px solid #999 !important;\n    padding: 6px 8px !important;\n    min-width: 0 !important;\n  }\n  th {\n    background: #eee !important;\n  }\n  .tablewrap {\n    overflow: visible !important;\n    border: 0 !important;\n    box-shadow: none !important;\n  }\n}\n@media print {\n  body.printing-report .appframe,body.printing-report .shell,body.printing-report #reportView,body.printing-report .report,body.printing-report #wfhWorkspace,body.printing-report .wfh-grid{display:block!important;visibility:visible!important;position:static!important;inset:auto!important;width:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;box-shadow:none!important;overflow:visible!important;container-type:normal!important}\n  body.printing-report #reportView>*:not(.report),body.printing-report .report>*:not(#wfhWorkspace),body.printing-report #wfhWorkspace>*:not(.wfh-grid),body.printing-report #wfhSelectionPane{display:none!important}\n  body.printing-report #reportPreviewDialog{display:block!important;visibility:visible!important;position:static!important;inset:auto!important;width:100%!important;max-width:none!important;max-height:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;background:#fff!important;box-shadow:none!important;overflow:visible!important}\n  body.printing-report .report-paper-wrap{display:block!important;overflow:visible!important;padding:0!important;margin:0!important;background:#fff!important}\n  body.printing-report .report-paper{width:100%!important;max-width:none!important;min-height:0!important;padding:0!important;margin:0!important;box-shadow:none!important;font-size:10pt!important}\n  body.printing-report .report-paper table{display:table!important;width:100%!important;table-layout:fixed!important}\n  body.printing-report .report-paper thead{display:table-header-group!important;position:static!important;width:auto!important;height:auto!important;overflow:visible!important;clip-path:none!important}\n  body.printing-report .report-paper tbody{display:table-row-group!important}\n  body.printing-report .report-paper tr{display:table-row!important}\n  body.printing-report .report-paper th,body.printing-report .report-paper td{display:table-cell!important;padding:6px 8px!important;border:1px solid #0f172a!important}\n  body.printing-report .report-paper td::before{display:none!important}\n}\n:root{--ink-muted:#475569;--ink-tertiary:#475569;--brand:#1746ae;--success:#166534;--warning:#854d0e;--p2-color:#854d0e;--p4-color:#475569}\n.progress-status-pill.neutral{color:#475569}textarea::placeholder,input::placeholder{color:#64748b;opacity:1}\n.todo-check-btn:disabled{opacity:.5;cursor:wait}.todo-card .mini:disabled{opacity:.5}#quickMessage{font-size:13px;color:#991b1b;white-space:pre-wrap}.day-dot.wait{background:#854d0e}\n@media(max-width:768px){button,.todo-card button.mini{min-height:44px!important;min-width:44px!important}.todo-check-btn{flex:0 0 22px!important;width:22px!important;height:22px!important;min-width:22px!important;min-height:22px!important;max-width:22px!important;max-height:22px!important;aspect-ratio:1/1!important}.sidebar{background:rgba(248,250,252,.97)}#quickAddDialog input,#quickAddDialog select,#quickAddDialog textarea{font-size:16px!important}.undo-toast{max-width:calc(100vw - 24px)}}\n@media(forced-colors:active){button{border:1px solid ButtonText}.todo-check-btn{forced-color-adjust:auto}}\n</style>\n</head>\n<body>\n<div class=\"appframe\">\n  <aside class=\"sidebar\">\n    <div class=\"brand\">\n      <span class=\"brandmark\" title=\"E-Kinerja Harian ASN\">\n        <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\" fill=\"none\">\n          <!-- Blue Base Ribbon (Left & Bottom Spine) -->\n          <path d=\"M12 12C12 9.79 13.79 8 16 8H26L18 20H12V12Z\" fill=\"#4285F4\"/>\n          <path d=\"M12 18V36C12 38.21 13.79 40 16 40H26L20 32H16V22L12 18Z\" fill=\"#1A73E8\"/>\n          <path d=\"M16 40H32C34.21 40 36 38.21 36 36V28L28 34H18L16 40Z\" fill=\"#4285F4\"/>\n          <!-- Red Top Fold Ribbon -->\n          <path d=\"M24 8H32C34.21 8 36 9.79 36 12V20L30 14H22L24 8Z\" fill=\"#EA4335\"/>\n          <path d=\"M30 14L36 20H30V14Z\" fill=\"#D93025\"/>\n          <!-- Yellow Right & Accent Ribbon -->\n          <path d=\"M36 18V36C36 38.21 34.21 40 32 40L36 34V22L36 18Z\" fill=\"#F9AB00\"/>\n          <path d=\"M36 20V32L30 36H24L32 26L36 20Z\" fill=\"#FBBC04\"/>\n          <!-- Google Green Central Checkmark -->\n          <path d=\"M17 25L23 31L37 13\" stroke=\"#34A853\" stroke-width=\"5.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <path d=\"M17 25L23 31\" stroke=\"#0F9D58\" stroke-width=\"5.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          <circle cx=\"37\" cy=\"13\" r=\"1.5\" fill=\"#ffffff\"/>\n        </svg>\n      </span>\n      <div class=\"brand-info\">\n        <span class=\"brand-title\">E-Kinerja Harian</span>\n        <span class=\"brand-sub\">ASN</span>\n      </div>\n    </div>\n    <div class=\"navhint\">Ruang kerja</div>\n    <nav aria-label=\"Navigasi utama\">\n      <button id=\"navHome\" class=\"active\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z\"/></svg>\n        Home\n      </button>\n      <button id=\"navInput\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n        Input Kegiatan\n      </button>\n      <button id=\"navKanban\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"5\" height=\"16\" rx=\"1.5\"/><rect x=\"10\" y=\"4\" width=\"5\" height=\"11\" rx=\"1.5\"/><rect x=\"17\" y=\"4\" width=\"5\" height=\"14\" rx=\"1.5\"/></svg>\n        Papan Kanban\n      </button>\n      <button id=\"navCalendar\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2\"/></svg>\n        Kalender\n      </button>\n      <button id=\"navReport\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 2v6h6M8 13h8M8 17h6\"/></svg>\n        Rekap\n      </button>\n    </nav>\n    <div class=\"sidefoot\">\n      <a id=\"sourceLink\" hidden target=\"_blank\" rel=\"noopener\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 3h7v7M21 3l-9 9M10 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5\"/></svg>\n        Buka spreadsheet\n      </a>\n      <button id=\"sideThemeToggleBtn\" type=\"button\" class=\"side-theme-btn\" title=\"Ganti tema tampilan\" aria-label=\"Ganti tema tampilan\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3v18\"/></svg>\n        <span id=\"sideThemeLabel\">Tema: Sistem</span>\n      </button>\n      <button id=\"templateClonerBtn\" type=\"button\" class=\"side-theme-btn\" title=\"Bagi template bersih ke rekan ASN\" aria-label=\"Bagi template bersih\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"/></svg>\n        <span>Bagi Template Bersih</span>\n      </button>\n      <button id=\"installAppBtn\" type=\"button\" class=\"side-theme-btn\" style=\"display:none\" title=\"Install E-Kinerja sebagai aplikasi mandiri\" aria-label=\"Install Aplikasi\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3\"/></svg>\n        <span>Install Aplikasi</span>\n      </button>\n      <div class=\"semver-badge\">\n        <span class=\"semver-tag\">v0.8.17</span>\n        <span>Catatan pribadi ASN</span>\n      </div>\n      <div class=\"hotkey-hint\">\n        <span>Catat Cepat:</span> <kbd>Q</kbd>\n      </div>\n      <div class=\"hotkey-hint\">\n        <span>Form Lengkap:</span> <kbd>Alt</kbd>+<kbd>N</kbd>\n      </div>\n    </div>\n  </aside>\n\n  <main class=\"shell\">\n    <header>\n      <div>\n        <h1 id=\"pageTitle\">Home</h1>\n        <p id=\"pageSubtitle\">Ringkasan dan kegiatan terbaru Anda.</p>\n      </div>\n      <div class=\"actions\">\n        <button id=\"themeToggleBtn\" type=\"button\" class=\"theme-toggle-btn\" title=\"Ganti tema tampilan (Otomatis / Gelap / Terang)\" aria-label=\"Ganti tema tampilan\">\n          <svg class=\"icon theme-icon-auto\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3v18\"/><path d=\"M12 3a9 9 0 0 1 0 18z\" fill=\"currentColor\"/></svg>\n          <svg class=\"icon theme-icon-dark\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" style=\"display:none\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"/></svg>\n          <svg class=\"icon theme-icon-light\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" style=\"display:none\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/></svg>\n          <span id=\"themeToggleLabel\" class=\"theme-toggle-label\">Auto</span>\n        </button>\n        <button id=\"toggleSelectModeBtn\" type=\"button\" title=\"Pilih banyak kegiatan sekaligus\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"9 11 12 14 22 4\"/><path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\"/></svg>\n          <span id=\"selectModeLabel\">Pilih Banyak</span>\n        </button>\n        <button id=\"quickAddBtn\" title=\"Catat kilat kegiatan baru (Tekan Q)\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M13 2 3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n          Catat Cepat (Q)\n        </button>\n        <button id=\"refresh\" title=\"Muat ulang data terkini\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 7v5h-5M4 17v-5h5M6 7a7 7 0 0 1 12-1l2 3M4 15l2 3a7 7 0 0 0 12-1\"/></svg>\n          Muat ulang\n        </button>\n        <button id=\"add\" class=\"primary\" title=\"Catat kegiatan baru (Alt+N)\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n          Catat kegiatan\n        </button>\n      </div>\n    </header>\n\n    <div id=\"offlineBanner\" class=\"notice\" role=\"status\" aria-live=\"polite\" hidden>Koneksi internet terputus. Mode baca aktif; penyimpanan ke Google Sheets dijeda sampai koneksi kembali.</div>\n    <div id=\"demoBanner\" class=\"notice\" hidden>MODE COBA LOKAL · Data tersimpan di browser ini, belum terhubung ke Google Sheets.</div>\n    <div id=\"message\" class=\"notice\" role=\"status\" aria-live=\"polite\"></div>\n\n    <section id=\"homeView\" class=\"view\">\n      <div class=\"hero\">\n        <div>\n          <div class=\"eyebrow\" id=\"todayLabel\"></div>\n          <h2>Jurnal kerja</h2>\n          <p>Kegiatan, hasil, dan tindak lanjut dalam satu tempat.</p>\n          <div class=\"actions\" style=\"margin-top:18px\">\n            <button class=\"primary\" id=\"homeInput\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n              Input kegiatan\n            </button>\n            <button id=\"homeKanban\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"5\" height=\"16\" rx=\"1.5\"/><rect x=\"10\" y=\"4\" width=\"5\" height=\"11\" rx=\"1.5\"/><rect x=\"17\" y=\"4\" width=\"5\" height=\"14\" rx=\"1.5\"/></svg>\n              Papan Kanban\n            </button>\n            <button id=\"homeCalendar\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2\"/></svg>\n              Cek kalender\n            </button>\n          </div>\n        </div>\n        <div class=\"heroart\" aria-hidden=\"true\"></div>\n      </div>\n\n      <!-- PAKET 3: KARTU FOKUS HARI INI & HABIT TRACKING -->\n      <section class=\"panel focus-panel\" id=\"todayFocusSection\" aria-label=\"Fokus Kinerja Hari Ini\">\n        <div class=\"focus-header\">\n          <div>\n            <div class=\"focus-eyebrow\">\n              <span id=\"focusDateLabel\">Hari ini</span>\n              <span class=\"streak-badge\" id=\"streakBadge\" title=\"Jumlah hari kalender dengan catatan berturut-turut\">\n                <span class=\"streak-icon\">🔥</span>\n                <strong id=\"streakCount\">0</strong> Hari Berturut-turut\n              </span>\n            </div>\n            <h2 class=\"focus-title\">Fokus Hari Ini</h2>\n          </div>\n          <div class=\"focus-actions\">\n            <button type=\"button\" id=\"focusAddBtn\" class=\"mini primary\" title=\"Tambah kegiatan fokus hari ini\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n              + Catat Hari Ini\n            </button>\n          </div>\n        </div>\n\n        <!-- Daily Progress Bar -->\n        <div class=\"progress-container\">\n          <div class=\"progress-meta\">\n            <span class=\"progress-label\" id=\"todayProgressText\">0 dari 0 tugas selesai (0%)</span>\n            <span class=\"progress-status-pill neutral\" id=\"todayStatusBadge\">0%</span>\n          </div>\n          <div class=\"progress-track\" role=\"progressbar\" aria-label=\"Persentase kegiatan hari ini selesai\" aria-valuenow=\"0\" aria-valuemin=\"0\" aria-valuemax=\"100\">\n            <div class=\"progress-fill\" id=\"todayProgressFill\" style=\"width: 0%\"></div>\n          </div>\n        </div>\n\n        <!-- List of Today's Activities -->\n        <div id=\"todayTasksList\" class=\"today-tasks-list\"></div>\n      </section>\n\n      <div class=\"sectiontitle\">\n        <h2>Ringkasan bulan</h2>\n        <label class=\"period\" style=\"margin:0\">Periode <input type=\"month\" id=\"homeMonth\" min=\"2000-01\" max=\"2100-12\" aria-label=\"Periode ringkasan\"></label>\n      </div>\n\n      <section class=\"stats\" aria-label=\"Ringkasan bulan terpilih\">\n        <div class=\"stat\"><span>Kegiatan bulan ini</span><strong id=\"total\">—</strong></div>\n        <div class=\"stat\"><span>Selesai</span><strong id=\"done\">—</strong></div>\n        <div class=\"stat\"><span>Berjalan / menunggu</span><strong id=\"pending\">—</strong></div>\n        <div class=\"stat\"><span>Hari aktif kinerja</span><strong id=\"days\">—</strong></div>\n      </section>\n\n      <!-- Activity Heatmap Kontribusi Kinerja (ST2-04 / ST1-09) -->\n      <section class=\"heatmap-panel\" aria-label=\"Peta Aktivitas Kinerja Bulanan\">\n        <div class=\"heatmap-head\">\n          <div class=\"heatmap-title-wrap\">\n            <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>\n            <h3>Peta Kontribusi & Intensitas Kinerja</h3>\n          </div>\n          <div class=\"heatmap-legend\">\n            <span>Kurang</span>\n            <span class=\"heatmap-cell level-0\" title=\"0 kegiatan\"></span>\n            <span class=\"heatmap-cell level-1\" title=\"1-2 kegiatan\"></span>\n            <span class=\"heatmap-cell level-2\" title=\"3-4 kegiatan\"></span>\n            <span class=\"heatmap-cell level-3\" title=\"5+ kegiatan\"></span>\n            <span>Padat</span>\n          </div>\n        </div>\n        <div id=\"heatmapGrid\" class=\"heatmap-grid\" role=\"region\" aria-label=\"Kisi hari bulan terpilih\"></div>\n        <div id=\"heatmapSelectedDay\" class=\"heatmap-day-meta\" style=\"display:none\"></div>\n      </section>\n\n      <div class=\"homegrid\">\n        <section class=\"panel\">\n          <div class=\"panelhead\">\n            <h2>Kinerja terbaru</h2>\n            <button id=\"allNotes\" class=\"mini\">Lihat kalender</button>\n          </div>\n          <div class=\"home-search-box\">\n            <svg class=\"search-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>\n            <input type=\"search\" id=\"homeSearchInput\" placeholder=\"Cari kegiatan, hasil, bukti bulan ini…\" aria-label=\"Cari kegiatan bulan ini\">\n            <button type=\"button\" id=\"clearHomeSearch\" class=\"search-clear-btn\" title=\"Hapus pencarian\" style=\"display:none\">×</button>\n          </div>\n          <div id=\"homeSearchResultMeta\" class=\"home-search-meta\" style=\"display:none\"></div>\n          <div id=\"recentNotes\"></div>\n        </section>\n\n        <section class=\"panel\">\n          <h2>Laporan & penelusuran</h2>\n          <p>Buka rincian atau siapkan rekap kinerja.</p>\n          <div class=\"quickactions\">\n            <button id=\"quickInput\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n              Catat kegiatan\n            </button>\n            <button id=\"quickKanban\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"5\" height=\"16\" rx=\"1.5\"/><rect x=\"10\" y=\"4\" width=\"5\" height=\"11\" rx=\"1.5\"/><rect x=\"17\" y=\"4\" width=\"5\" height=\"14\" rx=\"1.5\"/></svg>\n              Papan Kanban\n            </button>\n            <button id=\"quickCalendar\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2\"/></svg>\n              Telusuri kalender\n            </button>\n            <button id=\"quickReport\">\n              <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z\"/><path d=\"M14 2v6h6M8 13h8M8 17h6\"/></svg>\n              Buat rekap\n            </button>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <!-- PAKET 5: KANBAN BOARD VIEW -->\n    <section id=\"kanbanView\" class=\"view kanban-view\" hidden>\n      <div class=\"kanban-toolbar\">\n        <div class=\"kanban-toolbar-info\">\n          <h2>Papan Status Kinerja</h2>\n          <p>Pantau alur kerja dan status kegiatan berdasarkan kolom status.</p>\n        </div>\n        <div class=\"kanban-toolbar-controls\">\n          <button type=\"button\" id=\"kanbanPrev\" aria-label=\"Bulan sebelumnya\" title=\"Bulan sebelumnya\">‹</button>\n          <input type=\"month\" id=\"kanbanMonth\" min=\"2000-01\" max=\"2100-12\" aria-label=\"Pilih bulan periode papan\">\n          <button type=\"button\" id=\"kanbanNext\" aria-label=\"Bulan berikutnya\" title=\"Bulan berikutnya\">›</button>\n          <button type=\"button\" id=\"kanbanAddBtn\" class=\"primary mini\" title=\"Catat kegiatan baru\">+ Kegiatan</button>\n        </div>\n      </div>\n\n      <div class=\"kanban-filter-bar\">\n        <div class=\"kanban-search-box\">\n          <svg class=\"icon search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n          <input type=\"search\" id=\"kanbanSearchInput\" placeholder=\"Cari kegiatan, hasil, bukti…\" aria-label=\"Cari kegiatan di papan Kanban\">\n        </div>\n        <div class=\"kanban-chips\" id=\"kanbanScopeChips\" role=\"group\" aria-label=\"Filter periode kegiatan\">\n          <button type=\"button\" class=\"chip-btn active\" id=\"chipScopeAll\" data-scope=\"ALL\">Semua Bulan</button>\n          <button type=\"button\" class=\"chip-btn\" id=\"chipScopeToday\" data-scope=\"TODAY\">Hari Ini</button>\n          <button type=\"button\" class=\"chip-btn\" id=\"chipScopeWeek\" data-scope=\"WEEK\">Minggu Ini</button>\n        </div>\n        <div class=\"kanban-chips\" id=\"kanbanPriorityChips\" role=\"group\" aria-label=\"Filter prioritas kegiatan\">\n          <button type=\"button\" class=\"chip-btn active\" id=\"chipPrioAll\" data-priority=\"ALL\">Semua</button>\n          <button type=\"button\" class=\"chip-btn p1\" id=\"chipPrioP1\" data-priority=\"P1\">P1</button>\n          <button type=\"button\" class=\"chip-btn p2\" id=\"chipPrioP2\" data-priority=\"P2\">P2</button>\n          <button type=\"button\" class=\"chip-btn p3\" id=\"chipPrioP3\" data-priority=\"P3\">P3</button>\n          <button type=\"button\" class=\"chip-btn p4\" id=\"chipPrioP4\" data-priority=\"P4\">P4</button>\n        </div>\n      </div>\n\n      <div class=\"kanban-board\" role=\"region\" aria-label=\"Papan Alur Kerja Kanban\">\n        <!-- Kolom 1: Menunggu -->\n        <div class=\"kanban-col\" id=\"colWait\">\n          <div class=\"kanban-col-head\">\n            <div class=\"kanban-col-title\">\n              <span class=\"kanban-col-indicator wait\"></span>\n              <span>Menunggu</span>\n            </div>\n            <span class=\"kanban-badge-count\" id=\"countWait\">0</span>\n          </div>\n          <div class=\"kanban-cards\" id=\"cardsWait\" aria-label=\"Daftar kegiatan menunggu\"></div>\n        </div>\n\n        <!-- Kolom 2: Sedang Berjalan -->\n        <div class=\"kanban-col\" id=\"colProgress\">\n          <div class=\"kanban-col-head\">\n            <div class=\"kanban-col-title\">\n              <span class=\"kanban-col-indicator progress\"></span>\n              <span>Sedang Berjalan</span>\n            </div>\n            <span class=\"kanban-badge-count\" id=\"countProgress\">0</span>\n          </div>\n          <div class=\"kanban-cards\" id=\"cardsProgress\" aria-label=\"Daftar kegiatan sedang berjalan\"></div>\n        </div>\n\n        <!-- Kolom 3: Selesai -->\n        <div class=\"kanban-col\" id=\"colDone\">\n          <div class=\"kanban-col-head\">\n            <div class=\"kanban-col-title\">\n              <span class=\"kanban-col-indicator done\"></span>\n              <span>Selesai</span>\n            </div>\n            <span class=\"kanban-badge-count\" id=\"countDone\">0</span>\n          </div>\n          <div class=\"kanban-cards\" id=\"cardsDone\" aria-label=\"Daftar kegiatan selesai\"></div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"calendarView\" class=\"view\" hidden>\n      <div class=\"pageintro\">\n        <h2>Kalender kegiatan</h2>\n        <p>Pilih tanggal untuk melihat atau menambahkan kegiatan.</p>\n      </div>\n      <div class=\"layout\">\n        <section class=\"panel\">\n          <div class=\"panelhead\">\n            <h2>Kalender</h2>\n            <div class=\"actions\">\n              <button id=\"prev\" aria-label=\"Bulan sebelumnya\" title=\"Bulan sebelumnya (Alt+Panah Kiri)\">‹</button>\n              <input class=\"month\" type=\"month\" id=\"month\" aria-label=\"Pilih bulan\" min=\"2000-01\" max=\"2100-12\">\n              <button id=\"next\" aria-label=\"Bulan berikutnya\" title=\"Bulan berikutnya (Alt+Panah Kanan)\">›</button>\n            </div>\n          </div>\n          <div class=\"calendar\" id=\"calendar\"></div>\n          <div class=\"legend\">\n            <div class=\"legend-items\">\n              <span class=\"legend-item\"><span class=\"day-dot\"></span> Selesai</span>\n              <span class=\"legend-item\"><span class=\"day-dot wait\"></span> Berjalan</span>\n            </div>\n            <span>Titik biru: hari ini · Klik tanggal untuk detail</span>\n          </div>\n        </section>\n\n        <section class=\"panel\">\n          <div class=\"panelhead\">\n            <div>\n              <div class=\"eyebrow\">Kegiatan pada</div>\n              <h2 id=\"selectedDate\"></h2>\n            </div>\n            <div class=\"actions\">\n              <button id=\"dateInput\" class=\"mini primary\">\n                <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>\n                Input\n              </button>\n              <button id=\"today\" class=\"mini\">Hari ini</button>\n            </div>\n          </div>\n          <div id=\"entries\" class=\"entries\"></div>\n        </section>\n      </div>\n    </section>\n\n    <section id=\"reportView\" class=\"view\" data-wfh-pane=\"selection\" hidden>\n      <div id=\"printHeader\">\n        <h2>REKAPITULASI E-KINERJA HARIAN ASN</h2>\n        <p id=\"printSubtitle\"></p>\n      </div>\n\n      <section class=\"panel report\">\n        <div class=\"panelhead\">\n          <div>\n            <h2>Rekap laporan</h2>\n            <p>Pilih periode, lalu salin atau unduh kinerja.</p>\n          </div>\n        </div>\n\n        <div class=\"actions\">\n          <div class=\"preset-bar\">\n            <span class=\"preset-title\">Pilihan Cepat:</span>\n            <button type=\"button\" class=\"preset-btn\" id=\"presetThisMonth\">Bulan Ini</button>\n            <button type=\"button\" class=\"preset-btn\" id=\"presetLastMonth\">Bulan Lalu</button>\n            <button type=\"button\" class=\"preset-btn\" id=\"presetThisWeek\">Minggu Ini</button>\n            <button type=\"button\" class=\"preset-btn\" id=\"presetThisYear\">Tahun Ini</button>\n          </div>\n\n          <div class=\"report-filters\">\n            <label style=\"margin:0\">Dari <input type=\"date\" id=\"from\" min=\"2000-01-01\" max=\"2100-12-31\"></label>\n            <label style=\"margin:0\">Sampai <input type=\"date\" id=\"to\" min=\"2000-01-01\" max=\"2100-12-31\"></label>\n            <label style=\"margin:0\">Filter Status\n              <select id=\"reportStatusFilter\">\n                <option value=\"all\">Semua Status</option>\n                <option value=\"Selesai\">Hanya Selesai</option>\n                <option value=\"pending\">Berjalan & Menunggu</option>\n              </select>\n            </label>\n            <button id=\"reportBtn\" class=\"primary\">Tampilkan</button>\n            <button id=\"copy\" disabled>Salin narasi</button>\n            <button id=\"csv\" disabled>Unduh CSV</button>\n          </div>\n        </div>\n\n        <section id=\"wfhWorkspace\" class=\"wfh-workspace\" aria-labelledby=\"wfhWorkspaceTitle\">\n          <div class=\"wfh-workspace-heading\">\n            <div>\n              <span class=\"eyebrow\">Dokumen kerja</span>\n              <h3 id=\"wfhWorkspaceTitle\">Laporan WFH</h3>\n              <p>Pilih kegiatan, periksa identitas, lalu lihat lembar laporan sebelum membuat dokumen.</p>\n            </div>\n          </div>\n          <details id=\"wfhProfileDetails\" class=\"wfh-profile-details\">\n            <summary>\n              <span class=\"wfh-profile-label\">Identitas laporan <small>Klik untuk melihat atau mengubah</small></span>\n              <span class=\"wfh-profile-summary\"><strong id=\"wfhIdentityName\">Belum diisi</strong><span id=\"wfhIdentityUnit\">Belum diisi</span><span id=\"wfhIdentityReviewer\">Belum diisi</span><span id=\"wfhIdentityPaper\">Letter</span></span>\n            </summary>\n            <section id=\"profileView\" class=\"wfh-profile-form\">\n              <div class=\"wfh-profile-fields\">\n                <form id=\"profileForm\">\n                  <div class=\"eyebrow\">Privat di spreadsheet Anda</div>\n                  <h2>Profil laporan WFH</h2>\n                  <p class=\"hint\">Data ini dipakai untuk header dan tanda tangan laporan. Data tidak ditanam di source aplikasi.</p>\n                  <div class=\"formrow\">\n                    <label>Nama lengkap *<input id=\"profileFullName\" maxlength=\"160\" required autocomplete=\"name\"></label>\n                    <label>NIP / identitas pegawai<input id=\"profileEmployeeId\" maxlength=\"80\" autocomplete=\"off\"></label>\n                  </div>\n                  <div class=\"formrow\">\n                    <label>Status kepegawaian<input id=\"profileEmploymentStatus\" maxlength=\"100\"></label>\n                    <label>Pangkat / golongan<input id=\"profileRankGrade\" maxlength=\"100\"></label>\n                  </div>\n                  <label>Jabatan *<input id=\"profilePosition\" maxlength=\"200\" required></label>\n                  <label>Unit kerja *<input id=\"profileUnit\" maxlength=\"240\" required></label>\n                  <label>Bagian / korwas<input id=\"profileDivision\" maxlength=\"240\"></label>\n                  <div class=\"formrow\">\n                    <label>Nama penilai<input id=\"profileReviewerName\" maxlength=\"160\"></label>\n                    <label>Jabatan penilai<input id=\"profileReviewerPosition\" maxlength=\"200\"></label>\n                  </div>\n                  <div class=\"formrow formrow-3\">\n                    <label>Zona waktu *<select id=\"profileTimeZone\" required><option value=\"Asia/Jakarta\">WIB — Jakarta</option><option value=\"Asia/Makassar\">WITA — Makassar</option><option value=\"Asia/Jayapura\">WIT — Jayapura</option></select></label>\n                    <label>Mode laporan<input id=\"profileReportMode\" value=\"WFH\" readonly aria-readonly=\"true\"></label>\n                    <label>Ukuran halaman *<select id=\"profilePageSize\" required><option value=\"Letter\">Letter</option><option value=\"A4\">A4</option></select></label>\n                  </div>\n                  <div id=\"profileMessage\" role=\"status\"></div>\n                  <div class=\"formactions\">\n                    <span class=\"formstate\" id=\"profileState\">Belum dimuat</span>\n                    <button type=\"button\" id=\"deleteProfileBtn\">Hapus profil</button>\n                    <button type=\"submit\" id=\"saveProfileBtn\" class=\"primary\">Simpan profil</button>\n                  </div>\n                </form>\n              </div>\n            </section>\n          </details>\n          <div class=\"wfh-segments\" role=\"tablist\" aria-label=\"Ruang kerja laporan WFH\">\n            <button type=\"button\" id=\"wfhSelectTab\" role=\"tab\" aria-controls=\"wfhSelectionPane\" aria-selected=\"true\" tabindex=\"0\">Pilih kegiatan</button>\n            <button type=\"button\" id=\"wfhPreviewTab\" role=\"tab\" aria-controls=\"reportPreviewDialog\" aria-selected=\"false\" tabindex=\"-1\" disabled>Lembar dokumen</button>\n          </div>\n          <div class=\"wfh-grid\">\n            <section id=\"wfhSelectionPane\" class=\"wfh-selection-pane\" role=\"tabpanel\" aria-labelledby=\"wfhSelectTab\">\n              <div class=\"report-wfh-action\" aria-label=\"Siapkan laporan WFH\">\n                <div>\n                  <strong>Kegiatan untuk laporan</strong>\n                  <p id=\"reportSelectionSummary\" aria-live=\"polite\">Tampilkan rekap, lalu pilih kegiatan pada tabel untuk laporan WFH.</p>\n                </div>\n                <button id=\"previewWfhBtn\" class=\"primary\" disabled>Pratinjau laporan WFH</button>\n              </div>\n              <div id=\"reportWrap\" class=\"tablewrap\"></div>\n              <div class=\"hint\" id=\"reportHint\">Rekap berasal dari data kinerja tersimpan. Sesuaikan redaksi sebelum digunakan sebagai laporan resmi.</div>\n            </section>\n            <section id=\"reportPreviewDialog\" class=\"report-preview-dialog\" role=\"tabpanel\" aria-labelledby=\"wfhPreviewTab\" hidden>\n              <div class=\"report-preview-toolbar\">\n                <div class=\"report-preview-toolbar-left\">\n                  <div><strong>Lembar laporan WFH</strong><p id=\"reportPreviewState\" role=\"status\">Snapshot belum dibuat.</p></div>\n                  <span id=\"reportPaperBadge\" class=\"report-paper-badge\">Kertas: Letter</span>\n                </div>\n                <div class=\"dialog-actions\">\n                  <button type=\"button\" id=\"printPreviewBtn\" class=\"primary mini\" disabled>Cetak pratinjau</button>\n                  <button type=\"button\" id=\"exportWfhBtn\" class=\"mini\" disabled>Buat Google Docs + PDF</button>\n                  <a id=\"openWfhDoc\" class=\"mini\" href=\"#\" target=\"_blank\" rel=\"noopener\" hidden>Buka Google Docs</a>\n                  <a id=\"downloadWfhDocx\" class=\"mini\" href=\"#\" target=\"_blank\" rel=\"noopener\" hidden>Unduh DOCX</a>\n                  <a id=\"downloadWfhPdf\" class=\"mini\" href=\"#\" target=\"_blank\" rel=\"noopener\" hidden>Unduh PDF</a>\n                  <button type=\"button\" id=\"closeReportPreview\" class=\"mini\">Kembali ke kegiatan</button>\n                </div>\n              </div>\n              <div class=\"report-paper-wrap\"><article id=\"reportPreviewPaper\" class=\"report-paper\" aria-label=\"Pratinjau dokumen laporan WFH\"></article></div>\n            </section>\n          </div>\n        </section>\n      </section>\n\n      <div id=\"printFooter\">\n        <div class=\"print-sig\">\n          <div>Mengetahui,</div>\n          <div>Atasan Langsung</div>\n          <div class=\"print-sig-space\"></div>\n          <div>(..................................................)</div>\n        </div>\n        <div class=\"print-sig\">\n          <div>Jakarta, <span id=\"printDate\"></span></div>\n          <div>Pegawai Yang Bersangkutan</div>\n          <div class=\"print-sig-space\"></div>\n          <div>(..................................................)</div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"inputView\" class=\"view inputpage\" hidden>\n      <div class=\"panel\">\n        <form id=\"form\">\n          <div id=\"formDateBreadcrumb\" class=\"form-breadcrumb\">Mencatat untuk: <span id=\"formDateLabel\"></span></div>\n          <div class=\"eyebrow\">Kegiatan & hasil</div>\n          <h2 id=\"formTitle\">Catat kegiatan</h2>\n          <div class=\"formrow formrow-3\">\n            <label>Tanggal<input id=\"date\" type=\"date\" required min=\"2000-01-01\" max=\"2100-12-31\"></label>\n            <label>Status\n              <select id=\"status\">\n                <option>Selesai</option>\n                <option>Berjalan</option>\n                <option>Menunggu</option>\n              </select>\n            </label>\n            <label>Prioritas\n              <select id=\"priority\">\n                <option value=\"P4\">P4 Normal</option>\n                <option value=\"P1\">P1 Urgent (Merah)</option>\n                <option value=\"P2\">P2 Penting (Oranye)</option>\n                <option value=\"P3\">P3 Menengah (Biru)</option>\n              </select>\n            </label>\n          </div>\n          <label>\n            <div class=\"label-head\">\n              <span>Kegiatan *</span>\n              <span class=\"char-count\" id=\"activityCount\">0 / 3000</span>\n            </div>\n            <textarea id=\"activity\" required maxlength=\"3000\" placeholder=\"Apa yang dikerjakan?\"></textarea>\n          </label>\n          <label>\n            <div class=\"label-head\">\n              <span>Hasil / output *</span>\n              <span class=\"char-count\" id=\"resultCount\">0 / 3000</span>\n            </div>\n            <div class=\"format-toolbar\" id=\"resultFormatToolbar\" role=\"toolbar\" aria-label=\"Pilihan format hasil\">\n              <button type=\"button\" class=\"format-btn\" id=\"formatChecklistBtn\" title=\"Ubah atau sisipkan format checklist (- [ ])\">☑ Checklist</button>\n              <button type=\"button\" class=\"format-btn\" id=\"formatBulletBtn\" title=\"Ubah atau sisipkan format daftar poin (- )\">• Daftar Poin</button>\n              <button type=\"button\" class=\"format-btn\" id=\"formatTextBtn\" title=\"Hapus format daftar menjadi teks biasa\">📝 Teks Biasa</button>\n            </div>\n            <textarea id=\"result\" required maxlength=\"3000\" placeholder=\"Apa hasil atau kemajuannya?\"></textarea>\n          </label>\n          <label>Bukti / lokasi file<input id=\"evidence\" maxlength=\"1500\" placeholder=\"Tautan atau nama file (opsional)\"></label>\n          <div class=\"attachment-box\">\n            <label>Unggah dokumen atau gambar\n              <input id=\"attachmentFiles\" type=\"file\" multiple accept=\".pdf,.docx,.xlsx,.jpg,.jpeg,.png,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png\">\n            </label>\n            <p class=\"hint\">Maksimal 5 file per kegiatan dan 10 MB per file. File disimpan privat di folder Drive instalasi; kolom Bukti menerima tautannya.</p>\n            <div id=\"attachmentQueueHint\" class=\"hint\">Belum ada file dipilih.</div>\n            <div id=\"attachmentList\" class=\"attachment-list\" aria-live=\"polite\"></div>\n          </div>\n          <label>Tindak lanjut<textarea id=\"followup\" maxlength=\"3000\" placeholder=\"Langkah berikutnya (opsional)\"></textarea></label>\n          <div id=\"formMessage\" role=\"status\"></div>\n          <div class=\"formactions\">\n            <span class=\"formstate\" id=\"draftState\">Belum ada perubahan</span>\n            <button type=\"button\" id=\"deleteActivityBtn\" class=\"danger-button\" hidden>Hapus kegiatan</button>\n            <button type=\"button\" id=\"cancel\">Batal (Esc)</button>\n            <button type=\"submit\" id=\"save\" class=\"primary\">Simpan kegiatan</button>\n          </div>\n        </form>\n      </div>\n    </section>\n\n    <footer>Jumlah kegiatan adalah ringkasan pencatatan, bukan penilaian kinerja. Zona tanggal mengikuti setelan spreadsheet.<span id=\"buildVersion\">v0.8.17</span> · Streak: hari kalender dengan catatan; hari ini boleh belum terisi.</footer>\n  </main>\n</div>\n\n<dialog id=\"deleteActivityDialog\" class=\"delete-activity-dialog\" aria-labelledby=\"deleteActivityTitle\">\n  <h2 id=\"deleteActivityTitle\">Hapus kegiatan?</h2>\n  <p class=\"delete-warning\">Kegiatan akan dihapus dari Catatan Harian dan tidak lagi muncul di kalender, Kanban, atau rekap. Snapshot laporan lama yang memuat kegiatan ini tidak dapat diekspor ulang.</p>\n  <div id=\"deleteActivitySummary\" class=\"delete-summary\"></div>\n  <p class=\"delete-warning\">File lampiran tidak ikut dihapus dan tetap tersimpan privat di Google Drive.</p>\n  <div class=\"dialog-actions\">\n    <button type=\"button\" id=\"cancelDeleteActivity\">Batal</button>\n    <button type=\"button\" id=\"confirmDeleteActivity\" class=\"danger-button\">Hapus kegiatan</button>\n  </div>\n</dialog>\n\n<!-- Floating Multi-Select Batch Action Bar (TASK-602) -->\n<div id=\"batchBar\" class=\"batch-bar\" role=\"toolbar\" aria-label=\"Aksi Seleksi Massal\" hidden>\n  <span id=\"batchCount\" class=\"batch-count\">0 kegiatan dipilih</span>\n  <div class=\"batch-btns\">\n    <button type=\"button\" id=\"batchDoneBtn\" class=\"batch-btn primary\" title=\"Tandai semua yang dipilih sebagai Selesai\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n      Selesai\n    </button>\n    <button type=\"button\" id=\"batchProgressBtn\" class=\"batch-btn\" title=\"Ubah status ke Sedang Berjalan\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n      Berjalan\n    </button>\n    <button type=\"button\" id=\"batchWaitBtn\" class=\"batch-btn\" title=\"Ubah status ke Menunggu\">\n      <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"10\" y1=\"15\" x2=\"10\" y2=\"9\"/><line x1=\"14\" y1=\"15\" x2=\"14\" y2=\"9\"/></svg>\n      Menunggu\n    </button>\n    <button type=\"button\" id=\"batchCancelBtn\" class=\"batch-btn\" title=\"Batalkan seleksi\">✕</button>\n  </div>\n</div>\n\n<!-- Template Cloner Dialog (TASK-604) -->\n<dialog id=\"templateClonerDialog\">\n  <h2>Bagi Template Bersih ke Rekan ASN</h2>\n  <p>Master ini hanya spreadsheet kosong tanpa catatan pribadi. Agar menjadi aplikasi, penerima juga harus memasang kode rilis di Apps Script dan membuat deployment miliknya sendiri.</p>\n  <div class=\"cloner-steps\">\n    <div class=\"cloner-step\">\n      <span class=\"cloner-num\">1</span>\n      <div>\n        <strong>Buat Salinan Master Spreadsheet:</strong>\n        <p style=\"margin:4px 0 0;font-size:12px\">Buka tautan master template berikut dan klik tombol <em>Buat salinan (Make a copy)</em>.</p>\n        <div class=\"cloner-box\">\n          <input type=\"text\" id=\"clonerLinkInput\" class=\"cloner-input\" readonly value=\"\" placeholder=\"Master template publik belum tersedia\">\n          <button type=\"button\" id=\"clonerCopyBtn\" class=\"primary mini\" disabled>Salin Tautan</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"cloner-step\">\n      <span class=\"cloner-num\">2</span>\n      <div>\n        <strong>Pasang kode aplikasi:</strong>\n        <p style=\"margin:4px 0 0;font-size:12px\">Pada salinan baru, buka <strong>Extensions &rarr; Apps Script</strong>, lalu pasang source dari paket rilis resmi E-Kinerja. Salinan Sheet saja belum memiliki menu atau aplikasi. Paket rilis publik belum tersedia; jangan kirim tautan ini sebagai aplikasi siap pakai.</p>\n      </div>\n    </div>\n    <div class=\"cloner-step\">\n      <span class=\"cloner-num\">3</span>\n      <div>\n        <strong>Siapkan dan deploy milik penerima:</strong>\n        <p style=\"margin:4px 0 0;font-size:12px\">Jalankan <strong>E-Kinerja ASN &rarr; Siapkan salinan ini</strong>, setujui izin Google, lalu <strong>Deploy &rarr; New deployment &rarr; Web app</strong> dengan akses pribadi. Gunakan URL <code>/exec</code> deployment penerima, bukan URL aplikasi pembuat template.</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"formactions\" style=\"margin-top:16px;padding-top:12px\">\n    <button type=\"button\" id=\"closeCloner\">Tutup</button>\n  </div>\n</dialog>\n\n<dialog id=\"driveAuthDialog\">\n  <h2>Izinkan akses Google Drive</h2>\n  <p>Aplikasi memerlukan izin untuk membuat master template bersih serta menyimpan laporan WFH sebagai Google Docs dan PDF di Drive Anda.</p>\n  <p class=\"hint\"><strong>Jika Anda memilih Bagi Template Bersih:</strong> aplikasi membuat spreadsheet kosong terpisah, tanpa kegiatan atau profil Anda, lalu membagikannya sebagai <strong>Siapa saja yang memiliki link — Pelihat</strong>. File laporan WFH tetap privat.</p>\n  <p class=\"hint\">Google akan menampilkan layar persetujuan untuk project Apps Script milik Anda. Setelah selesai, kembali ke tab ini dan periksa izin.</p>\n  <div class=\"dialog-actions\">\n    <a id=\"driveAuthLink\" class=\"primary mini\" href=\"#\" target=\"_blank\" rel=\"noopener\">Izinkan Google Drive</a>\n    <button type=\"button\" id=\"driveAuthCheckBtn\" class=\"mini\">Periksa izin</button>\n    <button type=\"button\" id=\"closeDriveAuth\" class=\"mini\">Nanti</button>\n  </div>\n</dialog>\n\n<dialog id=\"copyDialog\">\n  <h2>Narasi Siap Disalin</h2>\n  <p>Pilih format narasi yang Anda butuhkan:</p>\n  <div class=\"dialog-actions\">\n    <button type=\"button\" id=\"copyFormatWa\" class=\"primary mini\">Format WhatsApp / Chat</button>\n    <button type=\"button\" id=\"copyFormatEkin\" class=\"mini\">Format Poin e-Kinerja</button>\n  </div>\n  <textarea id=\"copyText\" readonly></textarea>\n  <div class=\"formactions\" style=\"margin-top:12px;padding-top:12px\">\n    <button id=\"closeCopy\">Tutup</button>\n  </div>\n</dialog>\n\n<dialog id=\"quickAddDialog\" class=\"quick-add-dialog\">\n  <form id=\"quickAddForm\" method=\"dialog\">\n    <div class=\"quick-add-header\">\n      <div class=\"quick-add-title\">\n        <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M13 2 3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\n        Catat Cepat (Quick Add)\n      </div>\n      <div class=\"hotkey-pill\"><kbd>Enter</kbd> simpan &nbsp; <kbd>Esc</kbd> tutup</div>\n    </div>\n    <div class=\"quick-add-body\">\n      <input maxlength=\"3000\" type=\"text\" id=\"quickAddInput\" class=\"quick-add-input\" placeholder=\"Ketik kegiatan, lalu pilih prioritas di bawah...\" autocomplete=\"off\" required>\n      <div id=\"quickAddSuggestionBar\" class=\"quick-suggestion-bar\" style=\"display:none\">\n        <div id=\"quickAddDateChip\" class=\"date-chip-btn\" role=\"button\" tabindex=\"0\" title=\"Klik untuk menerapkan tanggal ini\">\n          <svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M16 3v4M8 3v4M3 11h18\"/></svg>\n          <span id=\"quickAddDateChipText\">📅 Besok (14 Sep 2026)</span>\n          <span class=\"chip-action\">Terapkan</span>\n        </div>\n        <div id=\"quickAddPrioChip\" class=\"prio-chip-btn\" role=\"button\" tabindex=\"0\" style=\"display:none\" title=\"Klik untuk menerapkan prioritas ini\">\n          <span id=\"quickAddPrioChipText\">🔴 P1 Urgent</span>\n          <span class=\"chip-action\">Terapkan</span>\n        </div>\n      </div>\n      <label>\n        <div class=\"label-head\" style=\"margin-bottom:4px\">\n          <span>Hasil / kemajuan yang benar-benar dicapai *</span>\n        </div>\n        <div class=\"format-toolbar\" id=\"quickFormatToolbar\" role=\"toolbar\" aria-label=\"Pilihan format hasil cepat\">\n          <button type=\"button\" class=\"format-btn\" id=\"quickFormatChecklistBtn\" title=\"Ubah atau sisipkan format checklist (- [ ])\">☑ Checklist</button>\n          <button type=\"button\" class=\"format-btn\" id=\"quickFormatBulletBtn\" title=\"Ubah atau sisipkan format daftar poin (- )\">• Daftar Poin</button>\n          <button type=\"button\" class=\"format-btn\" id=\"quickFormatTextBtn\" title=\"Hapus format daftar menjadi teks biasa\">📝 Teks Biasa</button>\n        </div>\n        <textarea id=\"quickAddResult\" required maxlength=\"3000\" placeholder=\"Isi hasil atau kemajuan saat ini\"></textarea>\n      </label>\n      <div id=\"quickMessage\" role=\"status\"></div>\n      <div class=\"quick-add-bar\">\n        <div class=\"quick-add-meta\">\n          <label style=\"margin:0;display:inline-flex;align-items:center;gap:4px\">\n            <span style=\"font-size:11px;color:var(--ink-muted)\">Prioritas:</span>\n            <select id=\"quickAddPriority\" class=\"mini-select\">\n              <option value=\"P4\">P4 Normal</option>\n              <option value=\"P1\">P1 Urgent (Merah)</option>\n              <option value=\"P2\">P2 Penting (Oranye)</option>\n              <option value=\"P3\">P3 Menengah (Biru)</option>\n            </select>\n          </label>\n          <label style=\"margin:0;display:inline-flex;align-items:center;gap:4px\">\n            <span style=\"font-size:11px;color:var(--ink-muted)\">Tanggal:</span>\n            <input type=\"date\" id=\"quickAddDate\" class=\"mini-date\" min=\"2000-01-01\" max=\"2100-12-31\" required>\n          </label>\n        </div>\n        <div class=\"quick-add-btns\">\n          <button type=\"button\" id=\"closeQuickAdd\" class=\"mini\">Batal</button>\n          <button type=\"submit\" id=\"submitQuickAdd\" class=\"primary mini\">Simpan</button>\n        </div>\n      </div>\n    </div>\n  </form>\n</dialog>\n\n<div id=\"undoToast\" class=\"undo-toast\" role=\"status\" aria-live=\"polite\" hidden>\n  <div class=\"undo-toast-content\">\n    <span id=\"undoToastText\">Kegiatan ditandai selesai.</span>\n    <button type=\"button\" id=\"undoBtn\">Batalkan <span id=\"undoCountdown\" class=\"undo-countdown\">(5s)</span></button>\n  </div>\n  <div id=\"undoProgressBar\" class=\"undo-progress-bar\"></div>\n</div>\n\n<script>\n'use strict';\n// Pure date-only and record functions; shared by runtime and regression tests.\nconst Domain=Object.freeze({\n  ymd(date,zone){return new Intl.DateTimeFormat('en-CA',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'}).format(date);},\n  addDays(ymd,days){const d=new Date(ymd+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+days);return d.toISOString().slice(0,10);},\n  week(ymd){const day=new Date(ymd+'T12:00:00Z').getUTCDay();const mon=this.addDays(ymd,-((day+6)%7));return [mon,this.addDays(mon,6)];},\n  streak(dates,today){const set=new Set(dates);let day=set.has(today)?today:this.addDays(today,-1),count=0;while(set.has(day)){count++;day=this.addDays(day,-1);}return count;},\n  same(a,b){return !!a&&!!b&&['id','date','activity','result','evidence','status','followup'].every(k=>a[k]===b[k]);},\n  recent(a,b){return String(b.date||'').localeCompare(String(a.date||''))||String(b.updated||'').localeCompare(String(a.updated||''))||String(a.id||'').localeCompare(String(b.id||''));}\n});\n\n// Confirmed writes with a shared mutation gate. Never infer rollback from transport failure.\nlet mutationBusy=false,mutationEpoch=0,unresolvedId=null;\nlet isOnline=typeof navigator!=='undefined'&&'onLine' in navigator?navigator.onLine!==false:true;\nconst transientError=e=>!/sesi lain|tidak valid|wajib|terlalu panjang|SETUP:|DATA:|Kolom|permission|izin|not found|asal tidak ditemukan/i.test(e.message||'');\nasync function persistRecord(input){\n  if(typeof isOnline!=='undefined'&&!isOnline)throw new Error('OFFLINE: Perangkat sedang offline. Periksa koneksi internet Anda sebelum menyimpan.');\n  if(mutationBusy)throw new Error('Penyimpanan lain masih berlangsung. Tunggu konfirmasi.');\n  if(unresolvedId&&unresolvedId!==input.id)throw new Error('Ada penyimpanan belum terkonfirmasi. Klik Muat ulang sebelum melanjutkan.');\n  const payload=JSON.parse(JSON.stringify(input));mutationBusy=true;mutationEpoch++;loading++;invalidateReport();hideUndo();render();\n  try{\n    for(let attempt=0;attempt<3;attempt++){\n      try{const saved=await call('saveRecord',payload);unresolvedId=null;return saved;}\n      catch(error){\n        try{const current=await call('getRecord',payload.id);if(Domain.same(current,payload)){unresolvedId=null;return current;}if(current&&current.version!==payload.version)throw Object.assign(new Error('Catatan berubah di perangkat lain. Muat ulang lalu buka kembali catatan untuk memeriksa perubahan.'),{conflict:true});}\n        catch(readError){if(readError.conflict)throw readError;}\n        if(!transientError(error))throw error;\n        if(attempt===2){unresolvedId=payload.id;throw new Error('Hasil penyimpanan belum diketahui. Isian dipertahankan. Muat ulang atau coba simpan lagi dengan isian yang sama.');}\n        await new Promise(resolve=>setTimeout(resolve,400*2**attempt+Math.floor(Math.random()*150)));\n      }\n    }\n  }finally{mutationBusy=false;mutationEpoch++;loading++;monthCache.clear();invalidateReport();$('refresh').disabled=false;render();}\n}\n\n// Theme Manager (FR-401, FR-402, FR-403)\nconst THEME_KEY = 'ekinerja_theme';\nlet currentThemeSetting = 'auto';\n\nfunction getSystemTheme() {\n  return (typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';\n}\n\nfunction resolveEffectiveTheme(setting) {\n  if (setting === 'dark' || setting === 'light') return setting;\n  return getSystemTheme();\n}\n\nfunction updateThemeDOM(setting) {\n  currentThemeSetting = setting;\n  const effective = resolveEffectiveTheme(setting);\n  const rootEl = typeof document !== 'undefined' ? (document.documentElement || document.body) : null;\n  if (rootEl && rootEl.setAttribute) {\n    rootEl.setAttribute('data-theme', effective);\n    rootEl.setAttribute('data-theme-setting', setting);\n  }\n  \n  const labels = { auto: 'Auto', dark: 'Gelap', light: 'Terang' };\n  const sideLabels = {\n    auto: 'Tema: Sistem (' + (effective === 'dark' ? 'Gelap' : 'Terang') + ')',\n    dark: 'Tema: Gelap',\n    light: 'Tema: Terang'\n  };\n  \n  const labelEl = typeof $ === 'function' ? $('themeToggleLabel') : null;\n  if (labelEl) labelEl.textContent = labels[setting] || 'Auto';\n  \n  const sideLabelEl = typeof $ === 'function' ? $('sideThemeLabel') : null;\n  if (sideLabelEl) sideLabelEl.textContent = sideLabels[setting] || 'Tema';\n  \n  const btn = typeof $ === 'function' ? $('themeToggleBtn') : null;\n  if (btn) {\n    if (btn.setAttribute) {\n      btn.setAttribute('aria-label', 'Ganti tema tampilan: saat ini ' + (sideLabels[setting] || setting));\n    }\n    btn.title = 'Ganti tema tampilan (Saat ini: ' + (sideLabels[setting] || setting) + ' - Klik untuk beralih)';\n    const iconAuto = btn.querySelector ? btn.querySelector('.theme-icon-auto') : null;\n    const iconDark = btn.querySelector ? btn.querySelector('.theme-icon-dark') : null;\n    const iconLight = btn.querySelector ? btn.querySelector('.theme-icon-light') : null;\n    if (iconAuto && iconAuto.style) iconAuto.style.display = setting 