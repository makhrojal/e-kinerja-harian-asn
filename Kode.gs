adding: 0;\n  overflow: hidden;\n}\n\n.layout > .panel:first-child .panelhead {\n  padding: 16px 20px;\n  margin: 0;\n  border-bottom: 1px solid var(--border-subtle);\n  background: var(--bg-surface);\n}\n\n.layout > .panel:last-child {\n  padding: 20px;\n}\n\n.calendar {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(0, 1fr));\n  gap: 0;\n  background: var(--bg-surface);\n}\n\n.weekday {\n  padding: 9px 0;\n  text-align: center;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--ink-tertiary);\n  background: var(--bg-app);\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.day {\n  min-width: 0;\n  min-height: 88px;\n  border: 0;\n  border-right: 1px solid var(--border-light);\n  border-bottom: 1px solid var(--border-light);\n  border-radius: 0;\n  padding: 8px 6px;\n  display: flex;\n  align-items: stretch;\n  flex-direction: column;\n  justify-content: flex-start;\n  gap: 6px;\n  text-align: left;\n  font-size: 12px;\n  font-weight: 400;\n  background: var(--bg-surface);\n  box-shadow: none;\n  transition: background 0.12s ease;\n}\n\n.day:hover {\n  background: #f8fafc;\n}\n\n.day > span {\n  width: 25px;\n  height: 25px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--ink-primary);\n}\n\n.day.today > span {\n  background: var(--brand);\n  color: #ffffff;\n  font-weight: 600;\n  box-shadow: 0 1px 3px rgba(37, 99, 235, 0.35);\n}\n\n.day.selected {\n  background: #eff6ff;\n  box-shadow: inset 0 0 0 1.5px var(--brand);\n}\n\n.day-indicators {\n  display: flex;\n  gap: 4px;\n  align-items: center;\n  margin-top: auto;\n  min-height: 16px;\n}\n\n.day-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--success);\n  flex-shrink: 0;\n}\n\n.day-dot.wait {\n  background: var(--brand);\n}\n\n.day small {\n  background: #f1f5f9;\n  color: #334155;\n  border-radius: var(--radius-xs);\n  padding: 2.5px 5px;\n  font-size: 10px;\n  font-weight: 500;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  border: 1px solid rgba(226, 232, 240, 0.8);\n}\n\n.day small:empty {\n  display: none;\n}\n\n.legend {\n  padding: 12px 20px;\n  color: var(--ink-muted);\n  font-size: 11.5px;\n  background: #fafbfc;\n  border-top: 1px solid var(--border-light);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.legend-items {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.legend-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.entry {\n  padding: 14px 0;\n  border-bottom: 1px solid var(--border-light);\n}\n\n.entry:first-child {\n  padding-top: 0;\n}\n\n.entry:last-child {\n  border-bottom: 0;\n}\n\n.entry .row {\n  justify-content: space-between;\n}\n\n.entry h3 {\n  font-size: 13.5px;\n  font-weight: 600;\n  margin: 8px 0 4px;\n  color: var(--ink-primary);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.entry p {\n  font-size: 12.5px;\n  color: var(--ink-secondary);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  margin: 3px 0;\n}\n\n.entries {\n  max-height: 560px;\n  overflow-y: auto;\n  padding-right: 4px;\n}\n\n/* Input Form Page */\n.inputpage {\n  max-width: 720px;\n  margin: 0 auto;\n}\n\n.inputpage .panel {\n  padding: 28px 32px;\n  border-radius: var(--radius-xl);\n}\n\n.inputpage h2 {\n  font-size: 18px;\n  margin: 2px 0 16px;\n}\n\n.form-breadcrumb {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  background: var(--brand-tint);\n  color: var(--brand);\n  font-size: 11.5px;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  margin-bottom: 14px;\n  border: 1px solid rgba(37, 99, 235, 0.15);\n}\n\n.inputpage .eyebrow {\n  display: none;\n}\n\nlabel {\n  display: block;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--ink-secondary);\n  margin-top: 16px;\n  letter-spacing: 0.01em;\n}\n\n.label-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.char-count {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--ink-tertiary);\n  font-variant-numeric: tabular-nums;\n}\n\nlabel input, label select, label textarea {\n  display: block;\n  width: 100%;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  padding: 9px 12px;\n  margin-top: 6px;\n  color: var(--ink-primary);\n  background: var(--bg-surface);\n  font-weight: 400;\n  font-size: 13px;\n  transition: border-color 0.15s ease, box-shadow 0.15s ease;\n}\n\nlabel input:focus, label select:focus, label textarea:focus {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px var(--brand-subtle);\n  outline: none;\n}\n\ninput, textarea, select {\n  accent-color: var(--brand);\n}\n\ntextarea {\n  min-height: 90px;\n  resize: vertical;\n}\n\ntextarea::placeholder, input::placeholder {\n  color: #94a3b8;\n}\n\n.formrow {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n\n.formrow label {\n  margin-top: 0;\n}\n\n.formactions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n  padding-top: 20px;\n  margin-top: 24px;\n  border-top: 1px solid var(--border-light);\n}\n\n.formstate {\n  font-size: 11.5px;\n  color: var(--ink-muted);\n  margin-right: auto;\n  align-self: center;\n}\n\n.danger-button{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 38%,var(--border-subtle));background:var(--danger-bg)}\n.danger-button:hover{color:#fff!important;border-color:var(--danger)!important;background:var(--danger)!important}\n.delete-activity-dialog{max-width:460px}\n.delete-activity-dialog .delete-summary{margin:14px 0;padding:12px 14px;border:1px solid var(--border-subtle);border-radius:var(--radius-md);background:var(--bg-app);font-weight:600;color:var(--ink-primary)}\n.delete-activity-dialog .delete-warning{color:var(--ink-secondary);font-size:1