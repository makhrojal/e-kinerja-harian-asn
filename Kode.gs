 (priority !== 'P4') {\n    meta.append(node('span', priority, 'priority-pill ' + priority.toLowerCase()));\n  }\n  \n  const actionBtn = node('button', context === 'home' ? 'Lihat' : 'Edit', 'mini');\n  actionBtn.type = 'button';\n  actionBtn.onclick = () => {\n    if (context === 'home') {\n      selected = r.date;\n      if($('month').value!==r.date.slice(0,7)){$('month').value=r.date.slice(0,7);load();}else render();\n      go('calendar');\n    } else {\n      openForm(r);\n    }\n  };\n  header.append(meta, actionBtn);\n  \n  const title = node('h3', clean, 'todo-title' + (isDone ? ' done' : ''));\n  main.append(header, title);\n  renderResultContent(r, main, 'todo-desc');\n  if (r.evidence) main.append(node('p', 'Bukti: ' + r.evidence, 'todo-desc'));\n  if (r.followup) main.append(node('p', 'Tindak lanjut: ' + r.followup, 'todo-desc'));\n  \n  card.append(checkBtn, main);\n  return card;\n}\n\nasync function moveRecordStatus(r, targetStatus){\n  if(mutationBusy||!dataReady||unresolvedId)return;\n  if(r.status===targetStatus)return;\n  const oldStatus=r.status;\n  try{\n    message('Menyimpan perubahan status ke '+targetStatus+'…');\n    const saved=await persistRecord({...r,status:targetStatus});\n    await load(true);\n    showUndoToast(saved,oldStatus);\n  }catch(e){\n    await load(true);\n    message(e.message,true);\n  }\n}\n\nfunction createKanbanCard(r){\n  const card=node('article',undefined,'kanban-card'+(r.status==='Selesai'?' is-done':'')+(selectedRecordIds.has(r.id)?' selected':''));\n  const {priority,clean}=parsePriority(r.activity);\n  const isDone=r.status==='Selesai';\n\n  const selectCheck = node('input', undefined, 'card-select-checkbox');\n  selectCheck.type = 'checkbox';\n  selectCheck.checked = selectedRecordIds.has(r.id);\n  selectCheck.setAttribute('aria-label', 'Pilih kegiatan: ' + clean);\n  selectCheck.onclick = (e) => {\n    e.stopPropagation();\n    toggleRecordSelection(r.id);\n  };\n  card.append(selectCheck);\n\n  const meta=node('div',undefined,'kanban-card-meta');\n  meta.append(node('span',pretty(r.date),'kanban-card-date'));\n  if(priority!=='P4'){\n    meta.append(node('span',priority,'priority-pill '+priority.toLowerCase()));\n  }\n  card.append(meta);\n\n  const title=node('h4',clean,'kanban-card-title'+(isDone?' done':''));\n  card.append(title);\n\n  renderResultContent(r, card, 'kanban-card-desc');\n  if(r.evidence){\n    card.append(node('p','Bukti: '+r.evidence,'kanban-card-extra'));\n  }\n  if(r.followup){\n    card.append(node('p','Tindak lanjut: '+r.followup,'kanban-card-extra'));\n  }\n\n  const actions=node('div',undefined,'kanban-actions');\n  if(r.status==='Menunggu'){\n    const btnStart=node('button','Mulai →','kanban-btn');\n    btnStart.type='button';\n    btnStart.title='Mulai kegiatan (Pindah ke Sedang Berjalan)';\n    btnStart.onclick=(e)=>{e.stopPropagation();moveRecordStatus(r,'Berjalan');};\n\n    const btnDone=node('button','Selesai ✓','kanban-btn success');\n    btnDone.type='button';\n    btnDone.title='Tandai selesai';\n    btnDone.onclick=(e)=>{e.stopPropagation();moveRecordStatus(r,'Selesai');};\n\n    actions.append(btnStart,btnDone);\n  }else if(r.status==='Berjalan'){\n    const btnWait=node('button','← Tunda','kanban-btn warning');\n    btnWait.type='button';\n    btnWait.title='Tunda kegiatan (Pindah ke Menunggu)';\n    btnWait.onclick=(e)=>{e.stopPropagation();moveRecordStatus(r,'Menunggu');};\n\n    const btnDone=node('button','Selesai ✓','kanban-btn success');\n    btnDone.type='button';\n    btnDone.title='Tandai selesai';\n    btnDone.onclick=(e)=>{e.stopPropagation();moveRecordStatus(r,'Selesai');};\n\n    actions.append(btnWait,btnDone);\n  }else if(r.status==='Selesai'){\n    const btnReopen=node('button','← Buka Kembali','kanban-btn');\n    btnReopen.type='button';\n    btnReopen.title='Buka kembali (Pindah ke Sedang Berjalan)';\n    btnReopen.onclick=(e)=>{e.stopPropagation();moveRecordStatus(r,'Berjalan');};\n\n    actions.append(btnReopen);\n  }\n\n  const editBtn=node('button','Edit','kanban-btn');\n  editBtn.type='button';\n  editBtn.onclick=(e)=>{e.stopPropagation();openForm(r);};\n  actions.append(editBtn);\n\n  card.append(actions);\n  return card;\n}\n\nlet kanbanSearchQuery='';\nlet kanbanScopeFilter='ALL';\nlet kanbanPriorityFilter='ALL';\n\nfunction setKanbanScope(scope, activeBtn){\n  kanbanScopeFilter=scope;\n  const container=$('kanbanScopeChips');\n  if(container){\n    const btns=container.children||[];\n    for(let i=0;i<btns.length;i++){\n      const b=btns[i];\n      if(b.classList&&typeof b.classList.toggle==='function'){\n        b.classList.toggle('active',b===activeBtn);\n      }\n    }\n  }\n  renderKanban();\n}\n\nfunction setKanbanPriority(priority, activeBtn){\n  kanbanPriorityFilter=priority;\n  const container=$('kanbanPriorityChips');\n  if(container){\n    const btns=container.children||[];\n    for(let i=0;i<btns.length;i++){\n      const b=btns[i];\n      if(b.classList&&typeof b.classList.toggle==='function'){\n        b.classList.toggle('active',b===activeBtn);\n      }\n    }\n  }\n  renderKanban();\n}\n\nfunction renderKanban(){\n  const cardsWait=$('cardsWait'),cardsProgress=$('cardsProgress'),cardsDone=$('cardsDone');\n  if(!cardsWait||!cardsProgress||!cardsDone)return;\n\n  cardsWait.replaceChildren();\n  cardsProgress.replaceChildren();\n  cardsDone.replaceChildren();\n\n  if($('kanbanMonth'))$('kanbanMonth').value=$('month').value;\n\n  if(!dataReady){\n    cardsWait.append(node('div','Memuat data…','kanban-empty'));\n    cardsProgress.append(node('div','Memuat data…','kanban-empty'));\n    cardsDone.append(node('div','Memuat data…','kanban-empty'));\n    $('countWait').textContent='—';\n    $('countProgress').textContent='—';\n    $('countDone').textContent='—';\n    return;\n  }\n\n  const pWeight={P1:1,P2:2,P3:3,P4:4};\n  const sortFn=(a,b)=>{\n    const pA=pWeight[parsePriority(a.activity).priority]||4;\n    const pB=pWeight[parsePriority(b.activity).priority]||4;\n    if(pA!==pB)return pA-pB;\n    return (b.date||'').localeCompare(a.date||'');\n  };\n\n  let weekBounds=null;\n  if(kanbanScopeFilter==='WEEK'&&typeof Domain!=='undefined'&&typeof Domain.week==='function'&&today){\n    weekBounds=Domain.week(today);\n  }\n\n  const matchesFilter=(r)=>{\n    if(kanbanPriorityFilter!=='ALL'){\n      const p=parsePriority(r.activity).priority;\n      if(p!==kanbanPriorityFilter)return false;\n    }\n    if(kanbanScopeFilter==='TODAY'){\n      if(r.date!==today)return false;\n    }else if(kanbanScopeFilter==='WEEK'){\n      if(!weekBounds||r.date<weekBounds[0]||r.date>weekBounds[1])return false;\n    }\n    if(kanbanSearchQuery){\n      const q=kanbanSearchQuery.toLowerCase();\n      const act=(r.activity||'').toLowerCase();\n      const res=(r.result||'').toLowerCase();\n      const ev=(r.evidence||'').toLowerCase();\n      const fol=(r.followup||'').toLowerCase();\n      if(!act.includes(q)&&!res.includes(q)&&!ev.includes(q)&&!fol.includes(q))return false;\n    }\n    return true;\n  };\n\n  const isFiltered=(kanbanSearchQuery!==''||kanbanScopeFilter!=='ALL'||kanbanPriorityFilter!=='ALL');\n\n  const waitItems=records.filter(r=>r.status==='Menunggu'&&matchesFilter(r)).sort(sortFn);\n  const progressItems=records.filter(r=>r.status==='Berjalan'&&matchesFilter(r)).sort(sortFn);\n  const doneItems=records.filter(r=>r.status==='Selesai'&&matchesFilter(r)).sort(sortFn);\n\n  $('countWait').textContent=waitItems.length;\n  $('countProgress').textContent=progressItems.length;\n  $('countDone').textContent=doneItems.length;\n\n  const emptyMsg=isFiltered?'Tidak ada kegiatan sesuai filter.':'Tidak ada kegiatan menunggu.';\n  const emptyProgressMsg=isFiltered?'Tidak ada kegiatan sesuai filter.':'Tidak ada kegiatan berjalan.';\n  const emptyDoneMsg=isFiltered?'Tidak ada kegiatan sesuai filter.':'Belum ada kegiatan selesai.';\n\n  if(waitItems.length) waitItems.forEach(r=>cardsWait.append(createKanbanCard(r)));\n  else cardsWait.append(node('div',emptyMsg,'kanban-empty'));\n\n  if(progressItems.length) progressItems.forEach(r=>cardsProgress.append(createKanbanCard(r)));\n  else cardsProgress.append(node('div',emptyProgressMsg,'kanban-empty'));\n\n  if(doneItems.length) doneItems.forEach(r=>cardsDone.append(createKanbanCard(r)));\n  else cardsDone.append(node('div',emptyDoneMsg,'kanban-empty'));\n}\n\nlet quickId='',quickBusy=false;\nlet lastDetectedDate = null;\nlet lastDetectedPrio = null;\n\nfunction stripQuickToken(text, token) {\n  if (!text || !token) return text || '';\n  const escaped = token.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, '\\\\$&');\n  return text.replace(new RegExp(escaped, 'i'), '').replace(/\\s+/g, ' ').trim();\n}\n\nfunction parseNaturalDate(text, refYmd = today || Domain.ymd(new Date(), 'Asia/Jakarta')) {\n  if (!text || typeof text !== 'string') return null;\n  const s = text.trim();\n  const parts = refYmd.split('-').map(Number);\n  const ry = parts[0] || new Date().getFullYear();\n  const rm = parts[1] || (new Date().getMonth() + 1);\n  const rd = parts[2] || new Date().getDate();\n  const ref = new Date(Date.UTC(ry, rm - 1, rd, 12));\n\n  // 1. Relative keywords\n  const relPatterns = [\n    { re: /\\bhari ini\\b/i, days: 0, label: 'Hari ini' },\n    { re: /\\bbesok lusa\\b/i, days: 2, label: 'Lusa' },\n    { re: /\\bbesok\\b/i, days: 1, label: 'Besok' },\n    { re: /\\blusa\\b/i, days: 2, label: 'Lusa' },\n    { re: /\\bkemarin\\b/i, days: -1, label: 'Kemarin' }\n  ];\n\n  for (let i = 0; i < relPatterns.length; i++) {\n    const { re, days, label } = relPatterns[i];\n    const m = s.match(re);\n    if (m) {\n      const target = new Date(ref);\n      target.setUTCDate(target.getUTCDate() + days);\n      const ymd = target.toISOString().slice(0, 10);\n      return { ymd, label, token: m[0], cleanedText: stripQuickToken(s, m[0]) };\n    }\n  }\n\n  // 2. Weekdays\n  const daysMap = [\n    { re: /\\bminggu(\\s+depan)?\\b/i, day: 0, name: 'Minggu' },\n    { re: /\\bsenin(\\s+depan)?\\b/i, day: 1, name: 'Senin' },\n    { re: /\\bselasa(\\s+depan)?\\b/i, day: 2, name: 'Selasa' },\n    { re: /\\brabu(\\s+depan)?\\b/i, day: 3, name: 'Rabu' },\n    { re: /\\bkamis(\\s+depan)?\\b/i, day: 4, name: 'Kamis' },\n    { re: /\\bjumat(\\s+depan)?\\b/i, day: 5, name: 'Jumat' },\n    { re: /\\bsabtu(\\s+depan)?\\b/i, day: 6, name: 'Sabtu' }\n  ];\n\n  for (let i = 0; i < daysMap.length; i++) {\n    const { re, day, name } = daysMap[i];\n    const m = s.match(re);\n    if (m) {\n      const isDepan = /depan/i.test(m[0]);\n      const curDay = ref.getUTCDay();\n      let diff = day - curDay;\n      if (diff <= 0) diff += 7;\n      if (isDepan && diff < 7) diff += 7;\n      const target = new Date(ref);\n      target.setUTCDate(target.getUTCDate() + diff);\n      const ymd = target.toISOString().slice(0, 10);\n      const label = isDepan ? `${name} Depan` : name;\n      return { ymd, label, token: m[0], cleanedText: stripQuickToken(s, m[0]) };\n    }\n  }\n\n  // 3. 'tgl XX' or 'tanggal XX'\n  const tglMatch = s.match(/\\b(?:tgl|tanggal)\\s+(\\d{1,2})\\b/i);\n  if (tglMatch) {\n    const dNum = parseInt(tglMatch[1], 10);\n    if (dNum >= 1 && dNum <= 31) {\n      let targetY = ry;\n      let targetM = rm;\n      const daysInCurrentMonth = new Date(Date.UTC(targetY, targetM, 0)).getUTCDate();\n      if (dNum <= daysInCurrentMonth) {\n        if (dNum < rd) {\n          targetM++;\n          if (targetM > 12) { targetM = 1; targetY++; }\n        }\n        const ymd = `${targetY}-${String(targetM).padStart(2, '0')}-${String(dNum).padStart(2, '0')}`;\n        return { ymd, label: `Tgl ${dNum}`, token: tglMatch[0], cleanedText: stripQuickToken(s, tglMatch[0]) };\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction parsePriorityToken(text) {\n  if (!text || typeof text !== 'string') return null;\n  const m = text.match(/(?:^|\\s)((?:!|\\[)?p[1-4]\\]?)(?=$|\\s|[.,;:])/i);\n  if (m) {\n    const rawToken = m[1];\n    const pMatch = rawToken.match(/p[1-4]/i);\n    if (pMatch) {\n      const p = pMatch[0].toUpperCase();\n      const names = { P1: '🔴 P1 Urgent', P2: '🟠 P2 Penting', P3: '🔵 P3 Menengah', P4: '⚪ P4 Normal' };\n      return { priority: p, label: names[p] || p, token: rawToken, cleanedText: stripQuickToken(text, rawToken) };\n    }\n  }\n  return null;\n}\n\nfunction handleQuickAddInput() {\n  const input = $('quickAddInput');\n  if (!input) return;\n  const val = input.value;\n  const bar = $('quickAddSuggestionBar');\n  const dateChip = $('quickAddDateChip');\n  const dateText = $('quickAddDateChipText');\n  const prioChip = $('quickAddPrioChip');\n  const prioText = $('quickAddPrioChipText');\n\n  lastDetectedDate = parseNaturalDate(val, today);\n  lastDetectedPrio = parsePriorityToken(val);\n\n  let hasAny = false;\n  if (lastDetectedDate && dateChip && dateText) {\n    hasAny = true;\n    dateChip.style.display = 'inline-flex';\n    dateText.textContent = `📅 ${lastDetectedDate.label} (${pretty(lastDetectedDate.ymd)})`;\n    $('quickAddDate').value = lastDetectedDate.ymd;\n  } else if (dateChip) {\n    dateChip.style.display = 'none';\n  }\n\n  if (lastDetectedPrio && prioChip && prioText) {\n    hasAny = true;\n    prioChip.style.display = 'inline-flex';\n    prioText.textContent = lastDetectedPrio.label;\n    $('quickAddPriority').value = lastDetectedPrio.priority;\n  } else if (prioChip) {\n    prioChip.style.display = 'none';\n  }\n\n  if (bar) {\n    bar.style.display = hasAny ? 'flex' : 'none';\n  }\n}\n\nfunction quickDirty(){return !!($('quickAddInput').value.trim()||$('quickAddResult').value.trim());}\nfunction openQuickAdd(date=selected||today){\n  if(quickBusy||mutationBusy)return;\n  if(!quickDirty()){\n    quickId=uuid();\n    $('quickAddDate').value=typeof date==='string'?date:selected||today;\n    $('quickAddPriority').value='P4';\n  }\n  if($('quickAddSuggestionBar')) $('quickAddSuggestionBar').style.display = 'none';\n  lastDetectedDate = null;\n  lastDetectedPrio = null;\n  $('quickAddDi