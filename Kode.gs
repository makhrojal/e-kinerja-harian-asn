10px 12px}\n  .report-wfh-action button{width:100%;white-space:normal}\n  .wfh-selection-pane .tablewrap{max-height:none}\n}\n\n.report .actions {\n  padding: 16px 20px;\n  background: var(--bg-surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-xs);\n  margin-bottom: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.report label {\n  font-weight: 500;\n  margin-top: 0;\n  color: var(--ink-secondary);\n}\n\n.report input, .report select {\n  padding: 6px 10px;\n  margin-top: 4px;\n}\n\n.tablewrap {\n  overflow: auto;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  background: var(--bg-surface);\n  box-shadow: var(--shadow-xs);\n}\n\ntable {\n  border-collapse: collapse;\n  width: 100%;\n  font-size: 12.5px;\n}\n\nth, td {\n  text-align: left;\n  border-bottom: 1px solid var(--border-light);\n  padding: 11px 14px;\n  vertical-align: top;\n  min-width: 100px;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\nth {\n  background: #f8fafc;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--ink-muted);\n  border-bottom: 1px solid var(--border-subtle);\n}\n\ntr:hover td {\n  background: #f8fafc;\n}\n\ntd:nth-child(2), td:nth-child(3) {\n  min-width: 180px;\n}\n\n.hint {\n  font-size: 11.5px;\n  color: var(--ink-muted);\n  margin-top: 14px;\n  line-height: 1.5;\n}\n\na {\n  color: var(--brand);\n  text-decoration: none;\n}\n\na:hover {\n  text-decoration: underline;\n}\n\nfooter {\n  margin-top: 36px;\n  padding-top: 16px;\n  border-top: 1px solid var(--border-subtle);\n  color: var(--ink-tertiary);\n  font-size: 11px;\n}\n\n/* Dialogs */\ndialog {\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  padding: 24px;\n  width: min(560px, 94vw);\n  max-height: 90vh;\n  color: var(--ink-primary);\n  background: var(--bg-surface);\n  box-shadow: var(--shadow-f