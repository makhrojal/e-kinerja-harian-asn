Kinerja Harian ASN';\n if(view==='kanban')renderKanban();\n if(view==='profile'||view==='report'&&inlineProfile)loadProfile();\n window.scrollTo(0,0);\n}\n\nfunction calculateStreak(){return Domain.streak(activeDates,today);}\nfunction renderTodayFocus() {\n  const list = $('todayTasksList');\n  if (!list) return;\n  list.replaceChildren();\n\n  // Streak Counter\n  const streak = calculateStreak();\n  $('streakCount').textContent = dataReady?streak:'—';\n  $('focusDateLabel').textContent = new Intl.DateTimeFormat('id-ID', {\n    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone\n  }).format(new Date());\n\n  // Filter today's tasks\n  const todayTasks = todayRecords;\n  const totalToday = todayTasks.length;\n  const doneToday = todayTasks.filter(r => r.status === 'Selesai').length;\n  const pct = totalToday > 0 ? Math.round((doneToday / totalToday) * 100) : 0;\n\n  // Daily Progress Bar\n  $('todayProgressFill').style.width = pct + '%';\n  $('todayProgressFill').parentElement.setAttribute('aria-valuenow', pct);\n\n  const statusBadge = $('todayStatusBadge');\n  if(!dataReady){$('todayProgressText').textContent='Data hari ini belum dimuat';statusBadge.textContent='—';list.append(node('div','Muat ulang untuk mengambil data hari ini.','empty'));return;}\n  if (totalToday === 0) {\n    $('todayProgressText').textContent = 'Belum ada target kegiatan untuk hari ini';\n    statusBadge.textContent = '0%';\n    statusBadge.className = 'progress-status-pill neutral';\n  } else if (doneToday === totalToday) {\n    $('todayProgressText').textContent = `🎉 Seluruh kegiatan hari ini selesai (${doneToday}/${totalToday})`;\n    statusBadge.textContent = '100% Selesai';\n    statusBadge.className = 'progress-status-pill success';\n  } else {\n    $('todayProgressText').textContent = `${doneToday} dari ${totalToday} kegiatan selesai (${pct}%)`;\n    statusBadge.textContent = `${totalToday - doneToday} Tersisa`;\n    statusBadge.className = 'progress-status-pill pending';\n  }\n\n  if (!todayTasks.length) {\n    const emptyDiv = node('div', undefined, 'focus-empty');\n    emptyDiv.append(\n      node('p', 'Belum ada kegiatan yang dicatat untuk hari ini. Mulai dengan mencatat target kerja Anda sekarang!'),\n      node('button', '+ Catat Fokus Hari Ini', 'mini primary')\n    );\n    emptyDiv.querySelector('button').onclick = () => {\n      openQuickAdd(today);\n    };\n    list.append(emptyDiv);\n    return;\n  }\n\n  // Priority sort: incomplete first (P1 -> P2 -> P3 -> P4), then completed\n  const pWeight = { P1: 1, P2: 2, P3: 3, P4: 4 };\n  const sorted = todayTasks.slice().sort((a, b) => {\n    const aDone = a.status === 'Selesai' ? 1 : 0;\n    const bDone = b.status === 'Selesai' ? 1 : 0;\n    if (aDone !== bDone) return aDone - bDone;\n    const pA = pWeight[parsePriority(a.activity).priority] || 4;\n    const pB = pWeight[parsePriority(b.activity).priority] || 4;\n    if (pA !== pB) return pA - pB;\n    return (b.created || '').localeCompare(a.created || '');\n  });\n\n  sorted.forEach(r => list.append(createTodoCard(r, 'today')));\n}\n\nfunction filterHomeNotes(query){\n  const recent=$('recentNotes');\n  if(!recent) return;\n  recent.replaceChildren();\n  const q=(query||'').trim().toLowerCase();\n  const clearBtn=$('clearHomeSearch');\n  const meta=$('homeSearchResultMeta');\n  if(clearBtn) clearBtn.style.display = q ? 'inline-block' : 'none';\n\n  if(!q){\n    if(meta){ meta.style.display = 'none'; meta.textContent = ''; }\n    const items=records.slice().sort(Domain.recent).slice(0,5);\n    if(!items.length){\n      recent.append(node('div','Belum ada kegiatan pada bulan ini. Mulai dari tombol Catat Cepat (Q) atau Input Kegiatan.','empty'));\n      return;\n    }\n    items.forEach(r => recent.append(createTodoCard(r, 'home')));\n    return;\n  }\n\n  const filtered = records.filter(r => {\n    return (r.activity && r.activity.toLowerCase().includes(q)) ||\n           (r.result && r.result.toLowerCase().includes(q)) ||\n           (r.evidence && r.evidence.toLowerCase().includes(q)) ||\n           (r.followup && r.followup.toLowerCase().includes(q));\n  }).sort(Domain.recent);\n\n  if(meta){\n    meta.style.display = 'block';\n    meta.textContent = `Menemukan ${filtered.length} kegiatan cocok dengan \"${q}\"`;\n  }\n\n  if(!filtered.length){\n    recent.append(node('div',`Tidak ada kegiatan yang cocok dengan \"${q}\".`,'empty'));\n    return;\n  }\n  filtered.forEach(r => recent.append(createTodoCard(r, 'home')));\n}\n\nlet activeHeatmapDate = null;\n\nfunction renderHeatmap() {\n  const grid = $('heatmapGrid');\n  if (!grid) return;\n  grid.replaceChildren();\n\n  const m = $('homeMonth')?.value || (today ? today.slice(0, 7) : Domain.ymd(new Date(), 'Asia/Jakarta').slice(0, 7));\n  const parts = m.split('-').map(Number);\n  const y = parts[0] || new Date().getFullYear();\n  const n = parts[1] || (new Date().getMonth() + 1);\n  const totalDays = new Date(y, n, 0).getDate();\n\n  const countsByDate = new Map();\n  const recordsByDate = new Map();\n  records.forEach(r => {\n    if (r.date && r.date.startsWith(m)) {\n      countsByDate.set(r.date, (countsByDate.get(r.date) || 0) + 1);\n      if (!recordsByDate.has(r.date)) recordsByDate.set(r.date, []);\n      recordsByDate.get(r.date).push(r);\n    }\n  });\n\n  for (let day = 1; day <= totalDays; day++) {\n    const dayStr = String(day).padStart(2, '0');\n    const fullDate = `${m}-${dayStr}`;\n    const count = countsByDate.get(fullDate) || 0;\n\n    let level = 0;\n    if (count >= 5) level = 3;\n    else if (count >= 3) level = 2;\n    else if (count >= 1) level = 1;\n\n    const tile = document.createElement('div');\n    let tileClass = `heatmap-tile level-${level}`;\n    if (fullDate === today) tileClass += ' is-today';\n    if (fullDate === activeHeatmapDate) tileClass += ' is-active-filter';\n    tile.className = tileClass;\n\n    const dayDate = new Date(Date.UTC(y, n - 1, day, 12));\n    const dayName = new Intl.DateTimeFormat('id-ID', { weekday: 'short', timeZone: 'UTC' }).format(dayDate);\n    const monthName = new Intl.DateTimeFormat('id-ID', { month: 'short', timeZone: 'UTC' }).format(dayDate);\n    tile.title = `${dayName}, ${day} ${monthName}: ${count} kegiatan`;\n    tile.setAttribute('aria-label', tile.title);\n    tile.setAttribute('role', 'button');\n    tile.tabIndex = 0;\n\n    const dayNum = document.createElement('span');\n    dayNum.textContent = String(day);\n    tile.append(dayNum);\n\n    if (count > 0) {\n      const countEl = document.createElement('span');\n      countEl.className = 'tile-count';\n      countEl.textContent = String(count);\n      tile.append(countEl);\n    }\n\n    tile.onclick = () => {\n      selectHeatmapDay(fullDate, count, recordsByDate.get(fullDate) || []);\n    };\n    tile.onkeydown = e => {\n      if (e.key === 'Enter' || e.key === ' ') {\n        e.preventDefault();\n        tile.onclick();\n      }\n    };\n\n    grid.append(tile);\n  }\n}\n\nfunction selectHeatmapDay(dateStr, count, dayRecords) {\n  const meta = $('heatmapSelectedDay');\n  if (activeHeatmapDate === dateStr && !count) {\n    activeHeatmapDate = null;\n    if (meta) meta.style.display = 'none';\n    renderHeatmap();\n    filterHomeNotes($('homeSearchInput')?.value || '');\n    return;\n  }\n\n  if (activeHeatmapDate === dateStr) {\n    activeHeatmapDate = null;\n    if (meta) meta.style.display = 'none';\n    renderHeatmap();\n    filterHomeNotes($('homeSearchInput')?.value || '');\n    return;\n  }\n\n  activeHeatmapDate = dateStr;\n  renderHeatmap();\n\n  if (meta) {\n    meta.style.display = 'flex';\n    const doneCount = dayRecords.filter(r => r.status === 'Selesai').length;\n    const activeCount = dayRecords.filter(r => r.status !== 'Selesai').length;\n\n    meta.replaceChildren();\n    const infoSpan = document.createElement('span');\n    infoSpan.textContent = `📅 ${pretty(dateStr)}: ${count} kegiatan (${doneCount} selesai, ${activeCount} aktif) · `;\n\n    const calBtn = document.createElement('button');\n    calBtn.type = 'button';\n    calBtn.textContent = 'Buka di Kalender →';\n    calBtn.onclick = () => {\n      selected = dateStr;\n      go('calendar');\n    };\n\n    const resetBtn = document.createElement('button');\n    resetBtn.type = 'button';\n    resetBtn.style.marginLeft = '12px';\n    resetBtn.textContent = 'Reset Filter [×]';\n    resetBtn.onclick = () => {\n      activeHeatmapDate = null;\n      if (meta) meta.style.display = 'none';\n      renderHeatmap();\n      filterHomeNotes($('homeSearchInput')?.value || '');\n    };\n\n    meta.append(infoSpan, calBtn, resetBtn);\n  }\n\n  const recent = $('recentNotes');\n  if (!recent) return;\n  recent.replaceChildren();\n  if (!dayRecords.length) {\n    recent.append(node('div', `Tidak ada kegiatan tercatat pada ${pretty(dateStr)}.`, 'empty'));\n    return;\n  }\n  dayRecords.slice().sort(Domain.recent).forEach(r => recent.append(createTodoCard(r, 'home')));\n}\n\nfunction renderHome(){\n  renderTodayFocus();\n  renderHeatmap();\n  if (activeHeatmapDate) {\n    const dayRecords = records.filter(r => r.date === activeHeatmapDate);\n    selectHeatmapDay(activeHeatmapDate, dayRecords.length, dayRecords);\n    return;\n  }\n  filterHomeNotes($('homeSearchInput')?.value || '');\n}\n\n// Global Keyboard Shortcuts\nwindow.addEventListener('keydown',e=>{\n  const inField=['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName);\n  if(!inField&&(e.key==='q'||e.key==='Q')&&!e.altKey&&!e.ctrlKey&&!e.metaKey){\n    e.preventDefault();\n    openQuickAdd();\n    return;\n  }\n  if(e.altKey&&(e.key==='n'||e.key==='N')){\n    e.preventDefault();\n    openForm();\n  }else if(e.key==='Escape'){\n    if(busy||quickBusy||mutationBusy){e.preventDefault();return;}\n    if($('copyDialog').open){$('copyDialog').close();return;}\n    if($('quickAddDialog').open){\n      $('quickAddDialog').close();\n    }else if(!$('inputView').hidden){\n      go('home'); // Escape preserves the draft.\n    }else if($('copyDialog').open){\n      $('copyDialog').close();\n    }\n  }else if(e.altKey&&e.key==='ArrowLeft'){\n    e.preventDefault();\n    shift(-1);\n  }else if(e.altKey&&e.key==='ArrowRight'){\n    e.preventDefault();\n    shift(1);\n  }\n});\n\n$('navHome').onclick=()=>go('home');\n$('navInput').onclick=()=>{if(!formDirty()){resetForm();$('date').value=selected;$('formDateLabel').textContent=pretty(selected);formBaseline=formSnapshot();}go('input');};\nif($('navKanban'))$('navKanban').onclick=()=>go('kanban');\n$('navCalendar').onclick=()=>go('calendar');\n$('navReport').onclick=()=>go('report');\nif($('navProfile'))$('navProfile').onclick=()=>go('profile');\n$('focusAddBtn').onclick=()=>{\n  openQuickAdd(today);\n};\n['homeInput','quickInput','dateInput'].forEach(id=>$(id).onclick=()=>openForm());\n['homeCalendar','quickCalendar','allNotes'].forEach(id=>$(id).onclick=()=>go('calendar'));\nif($('homeKanban'))$('homeKanban').onclick=()=>go('kanban');\nif($('quickKanban'))$('quickKanban').onclick=()=>go('kanban');\nif($('kanbanAddBtn'))$('kanbanAddBtn').onclick=()=>openForm();\nif($('kanbanMonth'))$('kanbanMonth').onchange=()=>changeMonth($('kanbanMonth').value);\nif($('kanbanPrev'))$('kanbanPrev').onclick=()=>shift(-1);\nif($('kanbanNext'))$('kanbanNext').onclick=()=>shift(1);\nif($('kanbanSearchInput'))$('kanbanSearchInput').oninput=function(){kanbanSearchQuery=this.value.trim();renderKanban();};\nif($('chipScopeAll'))$('chipScopeAll').onclick=function(){setKanbanScope('ALL',this);};\nif($('chipScopeToday'))$('chipScopeToday').onclick=function(){setKanbanScope('TODAY',this);};\nif($('chipScopeWeek'))$('chipScopeWeek').onclick=function(){setKanbanScope('WEEK',this);};\nif($('chipPrioAll'))$('chipPrioAll').onclick=function(){setKanbanPriority('ALL',this);};\nif($('chipPrioP1'))$('chipPrioP1').onclick=function(){setKanbanPriority('P1',this);};\nif($('chipPrioP2'))$('chipPrioP2').onclick=function(){setKanbanPriority('P2',this);};\nif($('chipPrioP3'))$('chipPrioP3').onclick=function(){setKanbanPriority('P3',this);};\nif($('chipPrioP4'))$('chipPrioP4').onclick=function(){setKanbanPriority('P4',this);};\n$('quickReport').onclick=()=>go('report');\n$('homeMonth').onchange=()=>{\n  activeHeatmapDate=null;\n  if($('heatmapSelectedDay'))$('heatmapSelectedDay').style.display='none';\n  changeMonth($('homeMonth').value);\n};\nif($('homeSearchInput'))$('homeSearchInput').oninput=function(){\n  activeHeatmapDate=null;\n  if($('heatmapSelectedDay'))$('heatmapSelectedDay').style.display='none';\n  renderHome();\n};\nif($('clearHomeSearch'))$('clearHomeSearch').onclick=function(){\n  const input=$('homeSearchInput');\n  if(input){input.value='';input.focus();}\n  activeHeatmapDate=null;\n  if($('heatmapSelectedDay'))$('heatmapSelectedDay').style.display='none';\n  renderHome();\n};\n$('todayLabel').textContent=new Intl.DateTimeFormat('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Jakarta'}).format(new Date());\n\n// Multi-select batch action listeners (TASK-602)\nif($('toggleSelectModeBtn'))$('toggleSelectModeBtn').onclick=()=>toggleSelectMode();\nif($('batchDoneBtn'))$('batchDoneBtn').onclick=()=>executeBatchStatus('Selesai');\nif($('batchProgressBtn'))$('batchProgressBtn').onclick=()=>executeBatchStatus('Berjalan');\nif($('batchWaitBtn'))$('batchWaitBtn').onclick=()=>executeBatchStatus('Menunggu');\nif($('batchCancelBtn'))$('batchCancelBtn').onclick=()=>toggleSelectMode(false);\n\n// PWA Standalone Install handler (TASK-601)\nlet deferredInstallPrompt=null;\nwindow.addEventListener('beforeinstallprompt',e=>{\n  e.preventDefault();\n  deferredInstallPrompt=e;\n  if($('installAppBtn'))$('installAppBtn').style.display='inline-flex';\n});\nif($('installAppBtn')){\n  $('installAppBtn').onclick=async()=>{\n    if(!deferredInstallPrompt){\n      message('Fitur instalasi PWA didukung otomatis di Chromium/Android atau via menu Tambah ke Layar Utama di iOS.');\n      return;\n    }\n    deferredInstallPrompt.prompt();\n    const {outcome}=await deferredInstallPrompt.userChoice;\n    if(outcome==='accepted'){\n      message('Aplikasi E-Kinerja berhasil diinstal!');\n      $('installAppBtn').style.display='none';\n    }\n    deferredInstallPrompt=null;\n  };\n}\nwindow.addEventListener('appinstalled',()=>{\n  if($('installAppBtn'))$('installAppBtn').style.display='none';\n  message('Aplikasi E-Kinerja sudah terpasang di perangkat Anda.');\n});\n\n// Template Cloner Dialog (TASK-604)\nif($('templateClonerBtn'))$('templateClonerBtn').onclick=async()=>{\n  if(!await ensureDriveAuthorization())return;\n  const dialog=$('templateClonerDialog'),input=$('clonerLinkInput'),copy=$('clonerCopyBtn');\n  input.value='';copy.disabled=true;dialog.showModal();\n  try{\n    message('Menyiapkan dan memverifikasi master template bersih…');\n    const info=await call('ensureDistributionTemplate');\n    if(!info||!info.ready){message(info?.reason||'Master template belum siap.',true);return;}\n    input.value=info.copyUrl;copy.disabled=false;message('Master template bersih siap dibagikan.');\n  }catch(error){message('Master template belum dapat disiapkan: '+error.message,true);}\n};\nif($('closeCloner'))$('closeCloner').onclick=()=>$('templateClonerDialog').close();\nif($('closeDriveAuth'))$('closeDriveAuth').onclick=()=>$('driveAuthDialog').close();\nif($('driveAuthCheckBtn'))$('driveAuthCheckBtn').onclick=refreshDriveAuthorization;\nif($('clonerCopyBtn'))$('clonerCopyBtn').onclick=async()=>{\n  if($('clonerCopyBtn').disabled||!$('clonerLinkInput').value){message('Master template publik belum tersedia.',true);return;}\n  try{\n    await navigator.clipboard.writeText($('clonerLinkInput').value);\n    message('Tautan template berhasil disalin ke clipboard!');\n  }catch(e){\n    $('clonerLinkInput').select();\n    message('Silakan salin tautan template secara manual (Ctrl+C).');\n  }\n};\n\nfunction applyResultFormat(textareaId, formatType){\n  const ta=$(textareaId);\n  if(!ta)return;\n  const start=ta.selectionStart!=null?ta.selectionStart:0;\n  const end=ta.selectionEnd!=null?ta.selectionEnd:0;\n  const val=ta.value||'';\n\n  const lineStart=val.lastIndexOf('\\n',start-1)+1;\n  let lineEnd=val.indexOf('\\n',end);\n  if(lineEnd===-1)lineEnd=val.length;\n\n  const selectedLinesText=val.slice(lineStart,lineEnd);\n  const lines=selectedLinesText.split('\\n');\n\n  const transformed=lines.map(line=>{\n    const cleanLine=line.replace(/^[ \\t]*[-*](\\s*\\[[ xX]\\])?\\s*/,'');\n    if(formatType==='checklist'){\n      return line.trim()?`- [ ] ${cleanLine}`:`- [ ] `;\n    }else if(formatType==='bullet'){\n      return line.trim()?`- ${cleanLine}`:`- `;\n    }else{\n      return cleanLine;\n    }\n  });\n\n  const replacement=transformed.join('\\n');\n  const newVal=val.slice(0,lineStart)+replacement+val.slice(lineEnd);\n  \n  if(newVal.length<=(Number(ta.maxLength)||3000)){\n    ta.value=newVal;\n    const newCursor=lineStart+replacement.length;\n    if(typeof ta.setSelectionRange==='function')ta.setSelectionRange(newCursor,newCursor);\n    if(typeof ta.dispatchEvent==='function')ta.dispatchEvent(new Event('input',{bubbles:true}));\n  }\n  if(typeof ta.focus==='function')ta.focus();\n}\n\nfunction handleListSmartEnter(e, textareaId){\n  if(e.key!=='Enter'||e.shiftKey||e.ctrlKey||e.altKey||e.metaKey)return;\n  const ta=$(textareaId);\n  if(!ta)return;\n  const pos=ta.selectionStart!=null?ta.selectionStart:ta.value.length;\n  const val=ta.value||'';\n  const lineStart=val.lastIndexOf('\\n',pos-1)+1;\n  const line=val.slice(lineStart,pos);\n\n  const emptyCheckMatch=line.match(/^[ \\t]*[-*]\\s*\\[[ xX]\\]\\s*$/);\n  if(emptyCheckMatch){\n    e.preventDefault();\n    const after=val.slice(pos);\n    ta.value=val.slice(0,lineStart)+after;\n    if(typeof ta.setSelectionRange==='function')ta.setSelectionRange(lineStart,lineStart);\n    if(typeof ta.dispatchEvent==='function')ta.dispatchEvent(new Event('input',{bubbles:true}));\n    return;\n  }\n\n  const checkMatch=line.match(/^([ \\t]*[-*]\\s*\\[)[ xX](\\]\\s*).+$/);\n  if(checkMatch){\n    e.preventDefault();\n    const insert='\\n- [ ] ';\n    if(val.length+insert.length<=(Number(ta.maxLength)||3000)){\n      const before=val.slice(0,pos);\n      const after=val.slice(pos);\n      ta.value=before+insert+after;\n      const newPos=pos+insert.length;\n      if(typeof ta.setSelectionRange==='function')ta.setSelectionRange(newPos,newPos);\n      if(typeof ta.dispatchEvent==='function')ta.dispatchEvent(new Event('input',{bubbles:true}));\n    }\n    return;\n  }\n\n  const emptyBulletMatch=line.match(/^[ \\t]*[-*]\\s*$/);\n  if(emptyBulletMatch){\n    e.preventDefault();\n    const after=val.slice(pos);\n    ta.value=val.slice(0,lineStart)+after;\n    if(typeof ta.setSelectionRange==='function')ta.setSelectionRange(lineStart,lineStart);\n    if(typeof ta.dispatchEvent==='function')ta.dispatchEvent(new Event('input',{bubbles:true}));\n    return;\n  }\n\n  const bulletMatch=line.match(/^([ \\t]*[-*]\\s+).+$/);\n  if(bulletMatch){\n    e.preventDefault();\n    const insert='\\n- ';\n    if(val.length+insert.length<=(Number(ta.maxLength)||3000)){\n      const before=val.slice(0,pos);\n      const after=val.slice(pos);\n      ta.value=before+insert+after;\n      const newPos=pos+insert.length;\n      if(typeof ta.setSelectionRange==='function')ta.setSelectionRange(newPos,newPos);\n      if(typeof ta.dispatchEvent==='function')ta.dispatchEvent(new Event('input',{bubbles:true}));\n    }\n    return;\n  }\n}\n\nif($('formatChecklistBtn'))$('formatChecklistBtn').onclick=()=>applyResultFormat('result','checklist');\nif($('formatBulletBtn'))$('formatBulletBtn').onclick=()=>applyResultFormat('result','bullet');\nif($('formatTextBtn'))$('formatTextBtn').onclick=()=>applyResultFormat('result','text');\nif($('result'))$('result').addEventListener('keydown',e=>handleListSmartEnter(e,'result'));\n\nif($('quickFormatChecklistBtn'))$('quickFormatChecklistBtn').onclick=()=>applyResultFormat('quickAddResult','checklist');\nif($('quickFormatBulletBtn'))$('quickFormatBulletBtn').onclick=()=>applyResultFormat('quickAddResult','bullet');\nif($('quickFormatTextBtn'))$('quickFormatTextBtn').onclick=()=>applyResultFormat('quickAddResult','text');\nif($('quickAddResult'))$('quickAddResult').addEventListener('keydown',e=>handleListSmartEnter(e,'quickAddResult'));\n\nfunction updateOnlineStatus(forced){\n  if(typeof forced==='boolean')isOnline=forced;\n  else if(typeof window!=='undefined'&&window.location&&window.location.search&&new URLSearchParams(window.location.search).has('offline'))isOnline=false;\n  else if(typeof navigator!=='undefined'&&'onLine' in navigator)isOnline=navigator.onLine!==false;\n  const banner=$('offlineBanner');\n  if(banner)banner.hidden=isOnline;\n  if(document.body&&document.body.classList)document.body.classList.toggle('is-offline',!isOnline);\n  if(!isOnline)message('Koneksi internet terputus. Mode baca aktif; penyimpanan dijeda.',true);\n}\nwindow.addEventListener('online',()=>{\n  updateOnlineStatus(true);\n  message('Koneksi internet kembali terhubung. Data siap disinkronkan.');\n  if(!mutationBusy&&!busy&&!quickBusy&&typeof load==='function')load(true);\n});\nwindow.addEventListener('offline',()=>{\n  updateOnlineStatus(false);\n});\nupdateOnlineStatus();\n\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden&&!mutationBusy&&!busy&&!quickBusy){const next=Domain.ymd(new Date(),timeZone);if(today!==next){const old=today;today=next;if(selected===old)selected=next;}invalidateReport();load(true);}});\nsetInterval(()=>{if(!document.hidden&&!mutationBusy&&!busy&&!quickBusy&&Domain.ymd(new Date(),timeZone)!==today){today=Domain.ymd(new Date(),timeZone);invalidateReport();load(true);}},60000);\nresetForm();go('home');\n\n$('month').value=today.slice(0,7);\n$('homeMonth').value=$('month').value;\nif($('kanbanMonth'))$('kanbanMonth').value=$('month').value;\n[$('from').value,$('to').value]=monthRange($('month').value);\n$('demoBanner').hidden=live;\ninitTheme();\nrender();\nload();\n\nif ('serviceWorker' in navigator) {\n  window.addEventListener('load', () => {\n    navigator.serviceWorker.register('./sw.js').then(reg => {\n      if (reg.installing) console.log('[PWA] Service Worker installing...');\n      else if (reg.active) console.log('[PWA] Service Worker active & ready.');\n    }).catch(err => {\n      console.warn('[PWA] Service Worker registration deferred/unavailable:', err.message || err);\n    });\n  });\n}\n</script>\n</body>\n</html>\n";
